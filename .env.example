## TimeOff.Management Environment Configuration

### Application Settings
BRANDING_URL=http://localhost:3000     # URL where the application will be accessible
APP_PORT=3000                          # Port to run the application on
HEADER_TITLE="TimeOff Management"      # Application header title
COOKIE_BANNER_ENABLED=true             # Set to false to hide the cookie consent banner
# BRANDING_WEBSITE=                    # Optional: Your company's website URL
# CONTACT_EMAIL_ADDRESS=               # Optional: Contact email address
SHOW_PUBLIC_BANNER=false
PUBLIC_BANNER_MESSAGE="textgoeshere"
PUBLIC_MESSAGE_BG="#000000"
PUBLIC_MESSAGE_FONT="#ffffff"


### Database Configuration
# Works out of the box with `docker compose up` (bundled Postgres container).
# DOCKER_DB_URL is used by the app container; it takes precedence over DATABASE_URL there.
DOCKER_DB_URL="postgresql://timeoff-user:timeoff-pass@postgres:5432/timeoff-db"
# DATABASE_URL is used by tools run on your host (prisma, seed, npm start, tests).
# The compose Postgres publishes port 5432 on localhost.
DATABASE_URL="postgresql://timeoff-user:timeoff-pass@localhost:5432/timeoff-db"
# Used to create the Postgres container; keep in sync with the URLs above.
DB_DATABASE=timeoff-db
DB_USER=timeoff-user
DB_PASSWORD=timeoff-pass
DB_HOST=postgres

## External/hosted database (production): remove DOCKER_DB_URL and DB_*, set only DATABASE_URL:
# DATABASE_URL="postgresql://user:pass@host.example.com/dbname?sslmode=require"

### Security Settings
SESSION_SECRET=change_this_to_a_random_string
BACKUP_ENCRYPTION_KEY=change_this_to_a_secure_random_string_at_least_32_characters_long
OPTION_ALLOW_NEW_REGISTRATIONS=true   # Enable for initial setup, disable in production
# Dev-only defaults below: change SESSION_SECRET and BACKUP_ENCRYPTION_KEY for any real deployment
# API_KEY=                            # Optional: Set for API access

# Session TTL (24 hrs default)
SESSION_TTL="86400000"


### Email Configuration (optional)
SEND_EMAIL=false                      # Set to true to enable email notifications

### SMTP Configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_AUTH_REQUIRED=true             # Set to false if SMTP server doesn't require auth
# SMTP_AUTH_USER=
# SMTP_AUTH_PASS=
# SMTP_REQUIRE_TLS=true
# SMTP_FROM="Name <noreply@example.tld>"

### Resend API Configuration (alternative to SMTP)
# RESEND_API_KEY="api_key"            # if not provided, falls back to smtp

# cloudflare robo check
# TURNSTILE_SITE_KEY="keygoeshere"
# TURNSTILE_SECRET_KEY="keygoeshere"