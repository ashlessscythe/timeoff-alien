# Copy to .env.test and fill values. Used by Vitest (tests/support/loadEnvAndApp.js + tests/globalSetup.js).

# Required: Postgres URL for an isolated test database (never point at production).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/timeoff_test

# Session signing (any non-empty string is fine for local tests).
SESSION_SECRET=test-session-secret-change-me

# Allow POST /register in tests (also set in code if missing).
OPTION_ALLOW_NEW_REGISTRATIONS=true

# Leave empty so login/register do not require Cloudflare Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Use Postgres for sessions (matches default when SESSION_STORE is unset in app config).
# SESSION_STORE=database

# Optional: reduce email noise (app may still attempt SMTP depending on config).
# SEND_EMAIL=false

# Note: integration tests use @example.com addresses (Joi rejects the .test TLD).
