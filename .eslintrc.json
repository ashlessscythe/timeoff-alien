{
    "env": {
        "browser": true,
        "commonjs": true,
        "es2021": true
    },
    "extends": [
      "standard",
      "prettier"
    ],
    "parserOptions": {
        "ecmaVersion": "latest"
    },
    "rules": {
        "camelcase": 0,
        "space-before-function-paren": 0,
        "arrow-body-style": ["error", "as-needed"],
        "func-style": [
            "error",
            "declaration",
            { "allowArrowFunctions": true }
        ]
    },
    "overrides": [
      {
        "files": ["tests/**/*.mjs"],
        "env": {
          "node": true
        },
        "plugins": ["vitest"],
        "extends": ["plugin:vitest/legacy-recommended"]
      }
    ]
}
