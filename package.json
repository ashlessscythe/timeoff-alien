  "scripts": {
    "prettier": "prettier --write \"**/*.js\"",
    "lint": "eslint --ext .js \"**/*.js\"",
    "lint:fix": "eslint --ext .js \"**/*.js\" --fix",
    "lint:report": "eslint --ext .js \"**/*.js\" --max-warnings 0 || true",
    "test": "npm run test:unit && npm run test:integration",
    "test:quick": "npm run test:unit",
    "test:unit": "vitest run -c vitest.unit.config.js",
    "test:integration": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:formidable": "node scripts/test-formidable-migration.js",
    "start:dev": "node bin/wwww",
    "carry-over-allowance": "node bin/calculate_carry_over_allowance_for_all_users.js",
    "compile-sass": "node scripts/build-assets.js sass",
    "minify-css": "node scripts/build-assets.js minify-css",
    "minify-js": "node scripts/build-assets.js minify-js",
    "copy-static": "node scripts/build-assets.js copy-static",
    "sync-to-public": "node scripts/build-assets.js sync-to-public",
    "preinstall": "npx npm-force-resolutions",
    "build": "node scripts/build-assets.js",
    "start": "npx prisma generate && npx prisma migrate deploy && node scripts/start-prod.js",
    "dev": "node bin/wwww"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "resolutions": {
    "graceful-fs": "4.2.11"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "bcrypt@6.0.0": true,
    "dtrace-provider@0.8.8": true,
    "fsevents@2.3.3": true,
    "prisma@5.22.0": true,
    "sqlite3@6.0.1": true
  }
}
