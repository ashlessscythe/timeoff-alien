{
  "name": "TimeOff.Management",
  "version": "1.0.0",
  "private": false,
  "description": "Simple yet powerful absence management software for small and medium size business",
  "engines": {
    "node": ">=16.0.0"
  },
  "optionalDependencies": {
    "mysql2": "^3.9.1",
    "redis": "^3.1.2",
    "sqlite3": "^5.1.7"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "axios": ">=0.28.2",
    "tar": ">=2.1.2",
    "follow-redirects": ">=1.15.6",
    "underscore": ">=1.12.1",
    "minimatch": ">=10.2.1"
  },
  "dependencies": {
    "@handlebars/allow-prototype-access": "^1.0.5",
    "@prisma/client": "^5.21.0",
    "@slack/web-api": "^7.0.0",
    "bcrypt": "^5.1.1",
    "bluebird": "^3.5.4",
    "body-parser": "^1.19.0",
    "compression": "^1.7.4",
    "connect-redis": "^6.0.0",
    "connect-session-sequelize": "^7.1.7",
    "cookie-parser": "^1.4.4",
    "csv": "~5.1.1",
    "debug": ">=4.4.0",
    "express": "^4.16.4",
    "express-handlebars": "^8.0.1",
    "express-session": "^1.16.1",
    "formidable": "^3.5.4",
    "html-to-text": "^5.1.1",
    "ical-generator": "^1.7.1",
    "joi": "^17.13.3",
    "ldapauth-fork": "^4.2.0",
    "moment": "^2.24.0",
    "moment-timezone": "^0.5.25",
    "morgan": "^1.9.1",
    "multer": "^2.0.1",
    "nconf": "^0.12.1",
    "nodemailer": "^7.0.10",
    "nodemailer-smtp-transport": "^2.4.2",
    "optimist": "^0.5.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^1.0.0",
    "passport-http-bearer": "^1.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.4",
    "prisma": "^5.21.0",
    "resend": "^4.1.2",
    "sequelize": "^6.37.6",
    "sequelize-cli": "^5.5.1",
    "serve-favicon": "^2.5.0",
    "underscore": ">=1.12.1",
    "uuid": "^9.0.0",
    "validator": "^13.11.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.0.2",
    "chai": "^4.2.0",
    "clean-css-cli": "^5.6.3",
    "dotenv": "^16.4.7",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-mocha": "^10.2.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-promise": "^6.1.1",
    "i18n": "^0.15.1",
    "mocha": "^7.2.0",
    "prettier": "1.17.0",
    "proxyquire": "^2.1.3",
    "sass": "^1.93.2",
    "selenium-webdriver": "^4.30.0",
    "terser": "^5.34.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  },
  "scripts": {
    "prettier": "prettier --write \"**/*.js\"",
    "lint": "eslint --ext .js \"**/*.js\"",
    "lint:fix": "eslint --ext .js \"**/*.js\" --fix",
    "lint:report": "eslint --ext .js \"**/*.js\" --max-warnings 0 || true",
    "test": "npx mocha -r dotenv/config --exit --no-config --recursive t",
    "test:chrome": "USE_CHROME=1 npx mocha -r dotenv/config --exit --no-config --recursive t",
    "test:unit": "npx mocha -r dotenv/config --exit --no-config t/unit/",
    "test:integration": "npx mocha -r dotenv/config --exit --no-config t/integration/",
    "test:integration:auth": "npx mocha -r dotenv/config --exit --no-config t/integration/login_case_sensitive.js t/integration/register_*.js t/integration/try_to_register_*.js t/integration/try_to_open_private_pages_with_guest.js",
    "test:integration:users": "npx mocha -r dotenv/config --exit --no-config t/integration/crud_users.js t/integration/add_new_user_*.js t/integration/edit_user_*.js t/integration/*activate_user.js t/integration/users_import.js t/integration/user_edit_*.js t/integration/try_to_revoke_admin_*.js",
    "test:integration:company": "npx mocha -r dotenv/config --exit --no-config t/integration/company/ t/integration/department/ t/integration/menu_bar_*.js t/integration/timezone.js",
    "test:integration:employees": "npx mocha -r dotenv/config --exit --no-config t/integration/employees_page/ t/integration/employee_details_section/",
    "test:integration:leaves": "npx mocha -r dotenv/config --exit --no-config t/integration/leave_request/",
    "test:integration:leave-types": "npx mocha -r dotenv/config --exit --no-config t/integration/leave_type/",
    "test:integration:schedule": "npx mocha -r dotenv/config --exit --no-config t/integration/schedule/ t/integration/bank_holidays/",
    "test:integration:team": "npx mocha -r dotenv/config --exit --no-config t/integration/team_view/",
    "test:integration:carryover": "npx mocha -r dotenv/config --exit --no-config t/integration/carryOver/",
    "test:integration:api": "npx mocha -r dotenv/config --exit --no-config t/integration/integration_api/",
    "test:integration:quick": "npx mocha -r dotenv/config --exit --no-config t/integration/login_case_sensitive.js t/integration/register_new_user.js t/integration/crud_users.js",
    "test:file": "npx mocha -r dotenv/config --exit --no-config",
    "test:formidable": "node scripts/test-formidable-migration.js",
    "start:dev": "node bin/wwww",
    "carry-over-allowance": "node bin/calculate_carry_over_allowance_for_all_users.js",
    "compile-sass": "npx sass scss/main.scss build/css/style.css",
    "minify-css": "cleancss -o build/css/style.min.css build/css/style.css",
    "minify-js": "if [ -s public/js/global.js ]; then terser public/js/global.js -c -m -o build/js/global.min.js; else echo '// This file is intentionally left empty' > build/js/global.min.js; fi",
    "copy-static": "mkdir -p build/img build/fonts build/css build/js && cp -R public/img/* build/img/ 2>/dev/null || : && cp -R public/fonts/* build/fonts/ 2>/dev/null || : && cp -R public/css/*.css build/css/ 2>/dev/null || : && cp -R public/js/*.js build/js/ 2>/dev/null || :",
    "sync-to-public": "rm -rf public/* && cp -R build/* public/ && rm -rf build",
    "preinstall": "npx npm-force-resolutions",
    "prebuild": "npm run compile-sass && npm run minify-css && npm run minify-js && npm run copy-static && npm run sync-to-public",
    "build": "NODE_ENV=production npm run prebuild",
    "start": "npx prisma generate && npx prisma migrate deploy && NODE_ENV=production node bin/wwww",
    "dev": "node bin/wwww"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "resolutions": {
    "graceful-fs": "4.2.11"
  }
}
