# Local docker-compose / postgres development placeholders.
# Copy to .env.dev and adjust as needed. Do not commit real secrets.

DB_ROOT_PASSWORD=rootpass
DB_DATABASE=pgdb
DB_USERNAME=pguser
DB_PASSWORD=pgpass
DB_HOST=localhost
DB_DIALECT=postgres
DB_PORT=5432
DB_URL=postgres://pguser:pgpass@localhost:5432/pgdb
USE_SSL=false
OPTION_ALLOW_NEW_REGISTRATIONS=true
SMTP_HOST=''
