{{> header }}

<div class="auth-page">
  <div class="page-header">
    <div>
      <h1 class="page-header__title">Reset password</h1>
      <p class="page-header__subtitle">Choose a new password for your account</p>
    </div>
  </div>

  {{> show_flash_messages }}

  <div class="auth-card">
    <form class="form-modern" action="/reset-password/" method="post">
      <input type="hidden" name="t" value="{{token}}">

      <div class="mb-3">
        <label for="password_inp" class="form-label">New password</label>
        <input class="form-control" id="password_inp" type="password" name="password" required autocomplete="new-password">
      </div>

      <div class="mb-3">
        <label for="confirm_password_inp" class="form-label">Confirm new password</label>
        <input class="form-control" id="confirm_password_inp" type="password" name="confirm_password" required autocomplete="new-password">
      </div>

      {{#if turnstile_site_key}}
      <div class="mb-3">
        <div class="cf-turnstile" data-sitekey="{{turnstile_site_key}}"></div>
      </div>
      {{/if}}

      <button type="submit" class="btn btn-primary single-click" id="submit_login">Save</button>
    </form>
  </div>
</div>

{{> footer }}
