<div class="row">
  {{# unless leaves}}
  <div class="col-md-12">
    <div class="no-requests-card">
      <i class="fa fa-calendar-times-o"></i>
      <h3>No Leave Requests</h3>
      <p>There are no leave requests yet.</p>
    </div>
  </div>
  {{else}}

  <div class="col-md-12">
    <p class="visible-xs-block table-hint">
      <i class="fa fa-info-circle"></i>
      Scroll table horizontally to see all columns
    </p>
    <div class="table-responsive requests-table-container">
      <table class="table table-hover user-requests-table">
        <thead>
          <tr>
            <th>
              <i class="fa fa-calendar"></i>
              Dates (from <i class="fa fa-long-arrow-right"></i> to)
            </th>
            <th>
              <i class="fa fa-clock-o"></i>
              Date of Request
            </th>
            <th>
              <i class="fa fa-tag"></i>
              Type
            </th>
            <th>
              <i class="fa fa-minus-circle"></i>
              Deducted
            </th>
            <th>
              <i class="fa fa-user-check"></i>
              Approved by
            </th>
            <th>
              <i class="fa fa-cogs"></i>
              Actions
            </th>
            <th class="col-xs-2">
              <i class="fa fa-comment"></i>
              Comment
            </th>
            <th>
              <i class="fa fa-flag"></i>
              <span class="pull-right">Status</span>
            </th>
          </tr>
        </thead>

        <tbody>
          {{# each leaves }}

          <tr class="leave-request-row">
            <td data-tom-leave-dates="1">
              <a class="leave-details-summary-trigger leave-dates-link" data-leave-id="{{this.id}}" href="#">
                {{> leave_dates leave=this}}
              </a>
            </td>
            <td class="request-date">{{as_date_from_timestamp this.createdAt}}</td>
            <td class="leave-type">
              <span class="leave-type-name">{{ this.leave_type.name }}</span>
              {{#if this.is_pended_revoke_leave}}
              <br><span class="revoke-note">(pended revoke)</span>
              {{/if}}
            </td>
            <td class="deducted-days">{{ this.get_deducted_days_number }}</td>
            <td class="approver-name">{{#with this.approver}}{{this.full_name}}{{/with}}</td>
            <td class="action-buttons">
              {{#if this.is_approved_leave}}
              {{#unless this.is_pended_revoke_leave}}
              {{#if_equal ../logged_user.supervised_users.length 1}}
              {{#unless this.leave_type.manager_only}}
              <form method="post" action="/requests/revoke/">
                <input type="hidden" value="{{this.id}}" name="request">
                <button type="submit" class="btn btn-outline-danger btn-sm revoke-btn single-click"
                  title="Revoke leave request. Subject of approval.">
                  <i class="fa fa-trash"></i> Revoke
                </button>
              </form>
              {{/unless}}
              {{else}}
              <form method="post" action="/requests/revoke/">
                <input type="hidden" value="{{this.id}}" name="request">
                <button type="submit" class="btn btn-outline-danger btn-sm revoke-btn single-click"
                  title="Revoke leave request. Subject of approval.">
                  <i class="fa fa-trash"></i> Revoke
                </button>
              </form>
              {{/if_equal}}
              {{/unless}}
              {{else}}
              {{#if_equal this.user_id ../logged_user.id }}
              <form method="post" action='/requests/cancel/'>
                <input type="hidden" value="{{this.id}}" name="request">
                <button type="submit" class="btn btn-outline-warning btn-sm revoke-btn single-click"
                  title="Cancel leave request" value="cancel">
                  <i class="fa fa-times"></i> Cancel
                </button>
              </form>
              {{/if_equal}}
              {{/if}}
            </td>
            <td class="comment-cell">{{this.comment.comment}}</td>
            <td>
              <span class="pull-right leave-request-row-status status-badge
                {{#if this.is_new_leave }}status-pending
                {{else}}{{#if this.is_approved_leave}}status-approved{{else}}status-rejected{{/if}}{{/if}}">
                {{#if this.is_new_leave }}Pending{{else}}{{#if
                this.is_approved_leave}}Approved{{else}}Rejected{{/if}}{{/if}}
              </span>
            </td>
          </tr>

          {{/ each }}

        </tbody>
      </table>
    </div>
  </div>
  {{/unless}}
</div>

<style>
  /* User Requests Professional Styling */
  .no-requests-card {
    background: var(--background-color);
    border: 2px solid var(--divider-color);
    border-radius: 12px;
    padding: 40px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .no-requests-card i {
    font-size: 3rem;
    color: var(--accent-color);
    margin-bottom: 20px;
    display: block;
  }

  .no-requests-card h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 10px;
  }

  .no-requests-card p {
    font-size: 1.1rem;
    color: var(--text-color);
    margin: 0;
  }

  .table-hint {
    background: var(--hover-bg-color);
    border: 1px solid var(--divider-color);
    border-radius: 8px;
    padding: 10px 15px;
    margin-bottom: 15px;
    font-size: 1rem;
    color: var(--text-color);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .table-hint i {
    color: var(--accent-color);
  }

  .requests-table-container {
    background: var(--background-color);
    border: 2px solid var(--divider-color);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .user-requests-table {
    margin: 0;
    font-size: 1rem;
  }

  .user-requests-table thead th {
    background: var(--secondary-background-color);
    color: var(--text-color);
    font-weight: 600;
    font-size: 1.1rem;
    padding: 15px 12px;
    border-bottom: 2px solid var(--divider-color);
    text-align: left;
  }

  .user-requests-table thead th i {
    color: var(--accent-color);
    margin-right: 8px;
  }

  .user-requests-table tbody td {
    padding: 15px 12px;
    border-bottom: 1px solid var(--divider-color);
    vertical-align: middle;
    font-size: 1rem;
  }

  .leave-request-row:hover {
    background: var(--hover-bg-color);
  }

  .leave-dates-link {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 500;
  }

  .leave-dates-link:hover {
    color: var(--accent-color);
    text-decoration: underline;
  }

  .request-date {
    font-weight: 500;
    color: var(--text-color);
  }

  .leave-type-name {
    font-weight: 600;
    color: var(--text-color);
  }

  .revoke-note {
    font-size: 0.9rem;
    color: #ffc107;
    font-weight: 500;
  }

  .deducted-days {
    font-weight: 600;
    color: var(--accent-color);
    text-align: center;
  }

  .approver-name {
    font-weight: 500;
    color: var(--text-color);
  }

  .action-buttons {
    text-align: center;
  }

  .revoke-btn {
    font-size: 0.9rem;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.3s ease;
  }

  .revoke-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .comment-cell {
    font-style: italic;
    color: var(--text-color);
  }

  .status-badge {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .status-pending {
    background: #fff3cd;
    color: #856404;
    border: 1px solid #ffeaa7;
  }

  .status-approved {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .status-rejected {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .no-requests-card {
      padding: 30px 20px;
    }

    .no-requests-card i {
      font-size: 2.5rem;
    }

    .no-requests-card h3 {
      font-size: 1.3rem;
    }

    .no-requests-card p {
      font-size: 1rem;
    }

    .user-requests-table thead th {
      font-size: 1rem;
      padding: 12px 8px;
    }

    .user-requests-table tbody td {
      padding: 12px 8px;
      font-size: 0.9rem;
    }

    .revoke-btn {
      font-size: 0.8rem;
      padding: 5px 10px;
    }

    .status-badge {
      font-size: 0.8rem;
      padding: 4px 8px;
    }
  }

  @media (max-width: 480px) {
    .no-requests-card {
      padding: 20px 15px;
    }

    .no-requests-card i {
      font-size: 2rem;
    }

    .no-requests-card h3 {
      font-size: 1.2rem;
    }

    .user-requests-table thead th {
      font-size: 0.9rem;
      padding: 10px 6px;
    }

    .user-requests-table tbody td {
      padding: 10px 6px;
      font-size: 0.8rem;
    }

    .revoke-btn {
      font-size: 0.7rem;
      padding: 4px 8px;
    }
  }
</style>