<div class="modal fade" id="confirm_leave_action_modal" tabindex="-1" role="dialog"
  aria-labelledby="confirmLeaveActionModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span
            aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="confirmLeaveActionModalLabel">Confirm this action</h4>
      </div>
      <div class="modal-body">
        <p id="confirm_leave_action_body">Please confirm.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-link" data-dismiss="modal">Keep request</button>
        <button type="button" class="btn btn-danger" id="confirm_leave_action_submit">Confirm</button>
      </div>
    </div>
  </div>
</div>
