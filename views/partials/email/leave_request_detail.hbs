{{# with leave ~}}
  {{~# if this.get_leave_type_name ~}}{{~ this.get_leave_type_name }} {{/if~}}
  {{~# if this.time_start ~}}
    for {{format_time_duration this.time_start this.time_end}} on {{# with this.get_start_leave_day ~}}
      {{~ as_date this.date ~}}
    {{~/with~}}
  {{~ else ~}}
    from {{# with this.get_start_leave_day ~}}
      {{~ as_date this.date ~}}
      {{~# if this.is_morning_leave}} (AM){{/if~}}
      {{~# if this.is_afternoon_leave}} (PM){{/if~}}
    {{~/with~}} to {{# with this.get_end_leave_day ~}}
      {{~ as_date this.date ~}}
      {{~# if this.is_morning_leave}} (AM){{/if~}}
      {{~# if this.is_afternoon_leave}} (PM){{/if~}}
    {{~/with~}}
  {{~/if~}}
{{~/with~}}
