<div class="info-box">
  <h4 style="margin-top: 0; color: #1f2937; margin-bottom: 12px;">📊 Leave Balance Summary</h4>
  <p style="margin-bottom: 8px;">This year <strong>{{#with requester}}{{this.full_name}}{{/with}}</strong> has taken:
  </p>
  <ul style="padding-left: 20px; margin: 0;">
    <li style="margin-bottom: 6px;">
      <strong>{{~#with requesterAllowance}}{{this.number_of_days_taken_from_allowance}}{{/with~}} days</strong> from
      holiday allowance
    </li>
    <li style="margin-bottom: 6px;">
      <strong>{{#with requesterAllowance}}{{this.number_of_days_available_in_allowance}}{{/with}} days</strong> still
      available
      {{#if (lt requesterAllowance.number_of_days_available_in_allowance 0)}}
      <span style="color: #dc2626; font-weight: 600;">(overbooked by {{abs
        requesterAllowance.number_of_days_available_in_allowance}} days)</span>
      {{/if}}
    </li>
  </ul>
</div>