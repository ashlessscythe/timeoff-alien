<div class="col-md-9">

  {{> user_details/breadcrumb employee=employee }}

  <div class="row">
    <div class="col-xs-2">
      <a class="btn btn-default" href="/users/edit/{{current_user.id}}/calendar/?year={{previous_year}}"><span
          aria-hidden="true" class="fa fa-chevron-left"></span> {{previous_year}} </a>
    </div>
    <div class="col-xs-8 calendar-section-caption">
      <h3>{{current_year}}</h3>
    </div>
    <div class="col-xs-2">
      {{#if show_full_year}}
      <a class="btn btn-default pull-right"
        href="/users/edit/{{current_user.id}}/calendar/?year={{next_year}}{{#if show_full_year}}&show_full_year=1{{/if}}">{{next_year}}
        <span aria-hidden="true" class="fa fa-chevron-right"></span></a>
      {{/if}}
    </div>
  </div>

  <div class="row main-row_header">
    <div class="col-md-12">
      <hr />
    </div>
  </div>

  <div class="row">

    <div class="col-md-4 top-leave-type-statistics">
      <dl>
        {{#with current_user }}
        <div class="allowance-breakdown">
          <div class="big-number-container">
            <span class="big-number{{#if (lt ../user_allowance.vacation_remaining 0)}} negative{{/if}}"
              data-tom-days-available-in-allowance
              style="font-size: 70px !important; color: {{#if (lt ../user_allowance.vacation_remaining 0)}}#d9534f{{else}}#61686b{{/if}} !important; font-weight: 100 !important; line-height: 0.8 !important; text-shadow: 0 4px 8px rgba(0, 0, 0, 0.2) !important; margin: 0 !important; padding: 0 !important; display: inline-block !important;">{{
              ../user_allowance.vacation_remaining }}</span>
            <span class="slash"
              style="font-size: 60px !important; color: #61686b !important; font-weight: 200 !important; line-height: 0.8 !important; opacity: 0.7 !important; margin: 0 !important; padding: 0 !important; display: inline-block !important; text-shadow: 0 4px 8px rgba(0, 0, 0, 0.2) !important;">/</span>
            <span class="big-number{{#if (lt ../user_allowance.total_personal_available 0)}} negative{{/if}}"
              style="font-size: 70px !important; color: {{#if (lt ../user_allowance.total_personal_available 0)}}#d9534f{{else}}#61686b{{/if}} !important; font-weight: 100 !important; line-height: 0.8 !important; text-shadow: 0 4px 8px rgba(0, 0, 0, 0.2) !important; margin: 0 !important; padding: 0 !important; display: inline-block !important;">{{
              ../user_allowance.total_personal_available }}</span>
          </div>
          <div class="small-labels" style="display: flex; justify-content: center; gap: 40px; margin-top: 8px;">
            <span class="label-vac"
              style="font-size: 18px; color: #888; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; background: #f8f9fa; padding: 4px 12px; border-radius: 4px; border: 1px solid #e9ecef;">vac</span>
            <span class="label-per"
              style="font-size: 18px; color: #888; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; background: #f8f9fa; padding: 4px 12px; border-radius: 4px; border: 1px solid #e9ecef;">per</span>
          </div>
        </div>
        {{#if (lt ../user_allowance.number_of_days_available_in_allowance 0)}}
        <dd class="text-danger small">
          You're overbooked!
          <a href="#" class="text-danger" data-toggle="tooltip" data-placement="right"
            title="Cancel some requests so your balance is not negative" aria-label="Overbooked help" role="button"
            tabindex="0">
            <i class="fa fa-info-circle" aria-hidden="true"></i>
          </a>
        </dd>
        {{/if}}
        <dd>out of <span data-tom-total-days-in-allowance>{{ ../user_allowance.total_number_of_days_in_allowance
            }}</span> in total allowance</dd>
        {{#if ../pending_requests_count}}
        <dd class="text-info small">{{ ../pending_requests_count }} request{{#if (gt ../pending_requests_count
          1)}}s{{/if}}
          pending</dd>
        {{/if}}
        {{/with}}
      </dl>
    </div>

    <div class="col-md-4 secondary-leave-type-statistics hidden-xs">
      {{> user_details/allowance_breakdown user_allowance = user_allowance }}
    </div>

    <div class="col-md-4 secondary-leave-type-statistics hidden-xs">
      <dl>
        <dt>Used</dt>

        {{# if leave_type_statistics }}
        {{# each leave_type_statistics }}
        <dd><em>{{this.leave_type.name}}:</em> <span class="pull-right">{{this.days_taken}}{{# if this.limit}} out of
            {{this.limit}}{{/if}}</span></dd>
        {{/each}}
        {{else}}

        <dd class="text-muted">No approved requests so far.</dd>
        {{/if}}
      </dl>
    </div>

  </div>


  <div class="row main-row_header">
    <div class="col-md-12">
      <hr />
    </div>
  </div>

  <div class="row clearfix">
    {{# each calendar}}
    <div class="col-md-4 month_container">
      <table class="calendar_month month_{{ this.month }}">
        <thead>
          <tr>
            <td colspan="14">{{this.month}}</td>
          </tr>
          <tr>
            {{#if_equal ../company.first_day_of_week 0}}
            <td colspan="2">S</td>
            <td colspan="2">M</td>
            <td colspan="2">T</td>
            <td colspan="2">W</td>
            <td colspan="2">T</td>
            <td colspan="2">F</td>
            <td colspan="2">S</td>
            {{else}}
            <td colspan="2">M</td>
            <td colspan="2">T</td>
            <td colspan="2">W</td>
            <td colspan="2">T</td>
            <td colspan="2">F</td>
            <td colspan="2">S</td>
            <td colspan="2">S</td>
            {{/if_equal}}
          </tr>
        </thead>
        <tbody>
          {{#each this.weeks }}
          <tr>
            {{#each this}}
            {{> calendar_cell day = this}}
            {{/each}}
          </tr>
          {{/each}}

        </tbody>
      </table>
    </div>
    {{/each}}
  </div>


</div>