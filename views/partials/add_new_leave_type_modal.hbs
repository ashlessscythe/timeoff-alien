


<div class="modal fade" id="{{container_id}}" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
    <form id="leave_type_new_form" method="POST" action="{{form_action}}">
      <div class="modal-header">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <h4 class="modal-title">Add new Leave Type</h4>
      </div>

      <div class="modal-body">

        <div class="form-group">
          <label for="leave_type_name_new" class="form-label">Name:</label>
          <input type="text" class="form-control" id="leave_type_name_new" name="name__new" required>
        </div>

        <div class="form-group">
          <label class="form-label">Options</label>
          <div class="row">
            <div class="col-6">
              <div class="checkbox">
                <label class="form-label" for="leave_type_use_allovance_new">
                  <input type="checkbox" id="leave_type_use_allovance_new" name="use_allowance__new">
                  Use allowance
                </label>
              </div>
              <div class="checkbox">
                <label class="form-label" for="leave_type_use_personal_new">
                  <input type="checkbox" id="leave_type_use_personal_new" name="use_personal__new">
                  Use personal
                </label>
              </div>
              <div class="checkbox">
                <label class="form-label" for="leave_type_auto_approve_new">
                  <input type="checkbox" id="leave_type_auto_approve_new" name="auto_approve__new">
                  Auto approve
                </label>
              </div>
            </div>
            <div class="col-6">
              <div class="checkbox">
                <label class="form-label" for="leave_type_manager_new">
                  <input type="checkbox" id="leave_type_manager_new" name="manager_only__new">
                  Manager only
                </label>
              </div>
              <div class="checkbox">
                <label class="form-label" for="leave_type_special_new">
                  <input type="checkbox" id="leave_type_special_new" name="is_special__new">
                  Special leave
                </label>
              </div>
              <div class="checkbox">
                <label class="form-label" for="leave_type_allow_non_default_increments_new">
                  <input type="checkbox" id="leave_type_allow_non_default_increments_new" name="allow_non_default_increments__new">
                  Non-default increments
                </label>
              </div>
            </div>
          </div>
          <p><em>Choose how requests behave for this leave type.</em></p>
        </div>

        <div class="form-group">
          <div class="dropdown" data-tom-color-picker="1">
            <input type="color" id="colorPicker" name="color__new" value="#ffffff">
          </div>
          <p><em>Determine how leaves of new type are going to be highlighted on Calendar/Team view pages.</em></p>
        </div>



        <div class="form-group">
          <label for="leave_type_limit_new" class="form-label">Limit:</label>
          <input type="number" class="form-control" id="leave_type_limit_new" name="limit__new">
          <p><em>If set to non-zero value determines maximum number of days of new leave type each employee could take during the year.</em></p>
        </div>

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-link" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success single-click">Create</button>
      </div>
    </form>
    </div>
  </div>
</div>


