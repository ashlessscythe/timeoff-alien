  }

  .datepicker table tr td.today {
    background: var(--current-day-bg) !important;
    color: var(--text-color) !important;
    font-weight: 600 !important;
  }

  .datepicker table tr td.old,
  .datepicker table tr td.new {
    color: var(--hover-text-color) !important;
    opacity: 0.6 !important;
  }

  .datepicker .datepicker-switch {
    background: var(--secondary-background-color) !important;
    color: var(--text-color) !important;
    font-size: 1.4rem !important;
    font-weight: 600 !important;
    padding: 15px !important;
    border-bottom: 1px solid var(--divider-color) !important;
  }

  .datepicker .datepicker-switch:hover {
    background: var(--hover-bg-color) !important;
    color: var(--text-color) !important;
  }

  .datepicker .prev,
  .datepicker .next {
    background: var(--secondary-background-color) !important;
    color: var(--accent-color) !important;
    font-size: 1.3rem !important;
    padding: 15px !important;
    border-bottom: 1px solid var(--divider-color) !important;
  }

  .datepicker .prev:hover,
  .datepicker .next:hover {
    background: var(--hover-bg-color) !important;
    color: var(--accent-color) !important;
  }

  .datepicker tfoot tr th {
    background: var(--secondary-background-color) !important;
    color: var(--text-color) !important;
    font-size: 1.1rem !important;
    padding: 12px !important;
    border-top: 1px solid var(--divider-color) !important;
  }

  .datepicker tfoot tr th:hover {
    background: var(--hover-bg-color) !important;
    color: var(--text-color) !important;
  }

  /* Datepicker dropdown arrow */
  .datepicker-dropdown:before {
    border-bottom-color: var(--divider-color) !important;
  }

  .datepicker-dropdown:after {
    border-bottom-color: var(--background-color) !important;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .professional-modal .modal-title {
      font-size: 1.8rem;
    }

    .form-label {
      font-size: 1.2rem;
    }

    .modal-select,
    .modal-input,
    .modal-textarea {
      font-size: 1.1rem;
      padding: 12px 15px;
    }

    .professional-modal .btn {
      font-size: 1.1rem;
      padding: 10px 20px;
    }

    .datepicker {
      font-size: 1rem !important;
    }

    .datepicker table {
      font-size: 1rem !important;
    }

    .datepicker table tr th {
      font-size: 0.9rem !important;
      padding: 8px 4px !important;
    }

    .datepicker table tr td {
      font-size: 1rem !important;
      padding: 8px 4px !important;
    }

    .datepicker .datepicker-switch {
      font-size: 1.2rem !important;
      padding: 12px !important;
    }

    .datepicker .prev,
    .datepicker .next {
      font-size: 1.1rem !important;
      padding: 12px !important;
    }
  }
</style>