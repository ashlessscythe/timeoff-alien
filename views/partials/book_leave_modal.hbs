<div class="modal fade" id="{{container_id}}" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
  aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="{{leave_modal_form_action}}" id="leaveForm" novalidate
        data-next-year-cutoff-date="{{#if logged_user.company.next_year_cutoff_date}}{{logged_user.company.next_year_cutoff_date}}{{/if}}"
        data-limited-departments="{{#if logged_user.company.limited_departments}}{{json logged_user.company.limited_departments}}{{/if}}"
        data-user-department-id="{{#if logged_user.department_id}}{{logged_user.department_id}}{{/if}}"
        data-logged-user-id="{{#if logged_user.id}}{{logged_user.id}}{{/if}}"
        data-allowed-increments-by-user="{{#if allowed_increments_by_user}}{{json allowed_increments_by_user}}{{/if}}"
        data-allowed-non-default-increments-by-leave-type="{{#if allowed_non_default_increments_by_leave_type}}{{json allowed_non_default_increments_by_leave_type}}{{/if}}"
        data-allowed-leave-type-ids-by-user="{{#if allowed_leave_type_ids_by_user}}{{json allowed_leave_type_ids_by_user}}{{/if}}"
        data-is-manager-or-admin="{{#if (or logged_user.admin logged_user.manager)}}true{{else}}false{{/if}}">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span
              aria-hidden="true">&times;</span></button>
          <h4 class="modal-title" id="exampleModalLabel">New absence</h4>
        </div>
        <div class="modal-body">

          {{#if (or logged_user.admin logged_user.manager)}}
          {{# if_equal logged_user.supervised_users.length 1 }}{{else}}
          <div class="form-group">
            <label for="employee" class="control-label">For employee:</label>
            <select class="form-control" id="employee" name="user" required>
              {{#each logged_user.supervised_users}}
              <option value="{{@index}}" data-user-id="{{this.id}}" {{# if_equal this.id ../logged_user.id
                }}selected="selected" {{/if_equal}}>
                {{this.full_name}}</option>
              {{/each}}
            </select>
          </div>
          {{/if_equal}}
          {{/if}}

          <div class="form-group">
            <label for="leave_type" class="control-label">Leave type:</label>
            <select class="form-control" id="leave_type" name="leave_type" required>
              {{# is_force_to_explicitly_select_type_when_requesting_new_leave}}
              <option disabled selected value>-- select an option --</option>
              {{/ is_force_to_explicitly_select_type_when_requesting_new_leave}}
              {{#each logged_user.company.leave_types }}
              <option value={{this.id}} data-tom="{{this.name}}" data-tom-index={{@index}} data-manager-only="{{#if this.manager_only}}true{{else}}false{{/if}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="form-group">
            <label for="from" class="control-label">Date:</label>
            <div class="row">
              <div class="col-md-4">
                <select class="form-control" id="increment_type" name="increment_type" required>
                  <option value="day" selected="selected">Full Day</option>
                  <option value="halfday">Half Day</option>
                  <option value="hr">Hours</option>
                  <option value="min">Minutes</option>
                </select>
              </div>
              <div class="col-md-3">
                <select class="form-control" id="increment_value" name="increment_value" required>
                  <option value="1" selected="selected">All day</option>
                </select>
              </div>
              <div class="col-md-12">
                <small id="non_default_increment_hint" style="display: none; color: #d9534f; opacity: 0.6;">
                  This leave type only allows full or half day increments.
                </small>
              </div>
              <div class="col-md-5">
                <div class="input-group">
                  <span class="input-group-addon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                  <input type="text" class="form-control book-leave-from-input" id="from" data-provide="datepicker"
                    data-date-autoclose="1"
                    data-date-format="{{# with logged_user.company }}{{this.get_default_date_format_for_date_picker}}{{/with}}"
                    data-date-week-start="{{logged_user.company.first_day_of_week}}" value="{{as_date booking_start}}"
                    name="from_date" required aria-label="Date">
                </div>
              </div>
            </div>
            <!-- Hidden fields for legacy day_part support -->
            <input type="hidden" id="from_date_part" name="from_date_part" value="1">
            <input type="hidden" id="to_date_part" name="to_date_part" value="1">
            <input type="hidden" id="time_start" name="time_start" value="">
            <input type="hidden" id="time_end" name="time_end" value="">
            <!-- To date is same as from date for single-day leaves, or can be set for multi-day full day leaves -->
            <input type="hidden" id="to" name="to_date" value="">
          </div>

          <div class="form-group" id="multi_day_group" style="display: none;">
            <label for="to_date_multi" class="control-label">To Date (for multi-day full day leaves):</label>
            <div class="input-group">
              <span class="input-group-addon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
              <input type="text" class="form-control book-leave-to-input" id="to_date_multi" data-provide="datepicker"
                data-date-autoclose="1"
                data-date-format="{{#with logged_user.company }}{{this.get_default_date_format_for_date_picker}}{{/with}}"
                data-date-week-start="{{logged_user.company.first_day_of_week}}" value=""
                aria-label="To date">
            </div>
            <p class="help-block"><em>Leave blank for single day. Only used for multi-day full day requests.</em></p>
          </div>

          <div class="form-group">
            <label for="leave_reason" class="control-label">Comment (optional):</label>
            <textarea class="form-control" id="leave_reason" name="reason"></textarea>
          </div>

          <div id="next_year_pto_warning" class="alert alert-danger" style="display: none; margin-top: 15px;">
            <strong>Warning:</strong> <span id="next_year_pto_warning_text"></span>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-link" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success single-click" id="submitLeaveBtn">Create</button>
          {{# if redirect_back_to }}
          <input type="hidden" name="redirect_back_to" value="{{redirect_back_to}}">
          {{else}}
          <input type="hidden" name="redirect_back_to" value="{{requested_path}}">
          {{/if}}
        </div>
      </form>
    </div>
  </div>
</div>
