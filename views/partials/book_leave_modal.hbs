  }

  .professional-modal .modal-body {
    padding: 30px;
  }

  .form-label {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .form-label i {
    color: var(--accent-color);
    font-size: 1.2rem;
  }

  .modal-select,
  .modal-input {
    font-size: 1.3rem;
    padding: 15px 18px;
    border-radius: 8px;
    border: 2px solid var(--divider-color);
    transition: border-color 0.3s ease;
    min-height: 50px;
  }

  .modal-select:focus,
  .modal-input:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    outline: none;
  }

  .modal-textarea {
    font-size: 1.3rem;
    padding: 15px 18px;
    border-radius: 8px;
    border: 2px solid var(--divider-color);
    transition: border-color 0.3s ease;
    resize: vertical;
    min-height: 80px;
  }

  .modal-textarea:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    outline: none;
  }

  .input-group-addon {
    background: var(--secondary-background-color);
    border: 2px solid var(--divider-color);
    border-right: none;
    color: var(--accent-color);
    font-size: 1.2rem;
    padding: 15px 18px;
  }

  .input-group .form-control {
    border-left: none;
  }

  .input-group .form-control:focus {
    border-left: none;
  }

  .professional-modal .modal-footer {
    background: var(--secondary-background-color);
    border-top: 1px solid var(--divider-color);
    padding: 20px 30px;
    border-radius: 0 0 12px 12px;
  }

  .professional-modal .btn {
    font-size: 1.2rem;
    font-weight: 500;
    padding: 12px 24px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
  }

  .btn-outline-secondary {
    background: transparent;
    color: var(--text-color);
    border: 2px solid var(--divider-color);
  }

  .btn-outline-secondary:hover {
    background: var(--hover-bg-color);
    color: var(--text-color);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  .btn-success {
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    border: none;
    color: white;
  }

  .btn-success:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(40, 167, 69, 0.4);
    color: white;
  }

  .close {
    font-size: 1.8rem;
    color: var(--hover-text-color);
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .close:hover {
    opacity: 1;
    color: var(--text-color);
  }

  /* Datepicker Calendar Styling */
  .datepicker {
    background: var(--background-color) !important;
    border: 2px solid var(--divider-color) !important;
    border-radius: 12px !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15) !important;
    font-size: 1.2rem !important;
  }

  .datepicker table {
    font-size: 1.2rem !important;
  }

  .datepicker table tr th {
    background: var(--secondary-background-color) !important;
    color: var(--text-color) !important;
    font-weight: 600 !important;
    font-size: 1.1rem !important;
    padding: 12px 8px !important;
    border-bottom: 1px solid var(--divider-color) !important;
  }

  .datepicker table tr td {
    color: var(--text-color) !important;
    font-size: 1.2rem !important;
    padding: 12px 8px !important;
    border-radius: 6px !important;
    transition: all 0.3s ease !important;
  }

  .datepicker table tr td:hover {
    background: var(--hover-bg-color) !important;
    color: var(--text-color) !important;
  }

  .datepicker table tr td.active,
  .datepicker table tr td.active:hover,
  .datepicker table tr td.active.disabled,
  .datepicker table tr td.active.disabled:hover {
    background: var(--accent-color) !important;
    color: white !important;
    font-weight: 600 !important;
  }

  .datepicker table tr td.today {
    background: var(--current-day-bg) !important;
    color: var(--text-color) !important;
    font-weight: 600 !important;
  }

  .datepicker table tr td.old,
  .datepicker table tr td.new {
    color: var(--hover-text-color) !important;
    opacity: 0.6 !important;
  }

  .datepicker .datepicker-switch {
    background: var(--secondary-background-color) !important;
    color: var(--text-color) !important;
    font-size: 1.4rem !important;
    font-weight: 600 !important;
    padding: 15px !important;
    border-bottom: 1px solid var(--divider-color) !important;
  }

  .datepicker .datepicker-switch:hover {
    background: var(--hover-bg-color) !important;
    color: var(--text-color) !important;
  }

  .datepicker .prev,
  .datepicker .next {
    background: var(--secondary-background-color) !important;
    color: var(--accent-color) !important;
    font-size: 1.3rem !important;
    padding: 15px !important;
    border-bottom: 1px solid var(--divider-color) !important;
  }

  .datepicker .prev:hover,
  .datepicker .next:hover {
    background: var(--hover-bg-color) !important;
    color: var(--accent-color) !important;
  }

  .datepicker tfoot tr th {
    background: var(--secondary-background-color) !important;
    color: var(--text-color) !important;
    font-size: 1.1rem !important;
    padding: 12px !important;
    border-top: 1px solid var(--divider-color) !important;
  }

  .datepicker tfoot tr th:hover {
    background: var(--hover-bg-color) !important;
    color: var(--text-color) !important;
  }

  /* Datepicker dropdown arrow */
  .datepicker-dropdown:before {
    border-bottom-color: var(--divider-color) !important;
  }

  .datepicker-dropdown:after {
    border-bottom-color: var(--background-color) !important;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .professional-modal .modal-title {
      font-size: 1.8rem;
    }

    .form-label {
      font-size: 1.2rem;
    }

    .modal-select,
    .modal-input,
    .modal-textarea {
      font-size: 1.1rem;
      padding: 12px 15px;
    }

    .professional-modal .btn {
      font-size: 1.1rem;
      padding: 10px 20px;
    }

    .datepicker {
      font-size: 1rem !important;
    }

    .datepicker table {
      font-size: 1rem !important;
    }

    .datepicker table tr th {
      font-size: 0.9rem !important;
      padding: 8px 4px !important;
    }

    .datepicker table tr td {
      font-size: 1rem !important;
      padding: 8px 4px !important;
    }

    .datepicker .datepicker-switch {
      font-size: 1.2rem !important;
      padding: 12px !important;
    }

    .datepicker .prev,
    .datepicker .next {
      font-size: 1.1rem !important;
      padding: 12px !important;
    }
  }
</style>