    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .form-label i {
    color: var(--accent-color);
    font-size: 1.2rem;
  }

  .modal-select,
  .modal-input {
    font-size: 1.3rem;
    padding: 15px 18px;
    border-radius: 8px;
    border: 2px solid var(--divider-color);
    transition: border-color 0.3s ease;
    min-height: 50px;
  }

  .modal-select:focus,
  .modal-input:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
