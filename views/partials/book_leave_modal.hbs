<div class="modal fade" id="{{container_id}}" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
  aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content professional-modal">
      <form method="POST" action="{{leave_modal_form_action}}" id="leaveForm" novalidate>
        <div class="modal-header">
          <div class="modal-title-section">
            <i class="fa fa-calendar-plus-o modal-icon"></i>
            <h4 class="modal-title" id="exampleModalLabel">New Absence Request</h4>
          </div>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span
              aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body">

          {{# if_equal logged_user.supervised_users.length 1 }}{{else}}
          <div class="form-group">
            <label for="employee" class="form-label">
              <i class="fa fa-user"></i> For Employee:
            </label>
            <select class="form-control modal-select" id="employee" name="user" required>
              {{#each logged_user.supervised_users}}
              <option value="{{@index}}" {{# if_equal this.id ../logged_user.id }}selected="selected" {{/if_equal}}>
                {{this.full_name}}</option>
              {{/each}}
            </select>
          </div>
          {{/if_equal}}

          <div class="form-group">
            <label for="leave_type" class="form-label">
              <i class="fa fa-tag"></i> Leave Type:
            </label>
            <select class="form-control modal-select" id="leave_type" name="leave_type" required>
              {{# is_force_to_explicitly_select_type_when_requesting_new_leave}}
              <option disabled selected value>-- Select an option --</option>
              {{/ is_force_to_explicitly_select_type_when_requesting_new_leave}}
              {{# if_equal logged_user.supervised_users.length 1 }}
              {{#each logged_user.company.leave_types }}
              {{#unless this.manager_only}}
              <option value={{this.id}} data-tom="{{this.name}}" data-tom-index={{@index}}>{{this.name}}</option>
              {{/unless}}
              {{/each}}
              {{else}}
              {{#each logged_user.company.leave_types }}
              <option value={{this.id}} data-tom="{{this.name}}" data-tom-index={{@index}}>{{this.name}}</option>
              {{/each}}
              {{/ if_equal}}
            </select>
          </div>

          <div class="form-group">
            <label for="from" class="form-label">
              <i class="fa fa-calendar"></i> From Date:
            </label>
            <div class="row">
              <div class="col-md-5">
                <select class="form-control modal-select" name="from_date_part" required>
                  <option value="1" selected="selected">All day</option>
                  <option value="2">AM</option>
                  <option value="3">PM</option>
                </select>
              </div>
              <div class="col-md-7">
                <div class="input-group">
                  <span class="input-group-addon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                  <input type="text" class="form-control book-leave-from-input modal-input" id="from"
                    data-provide="datepicker" data-date-autoclose="1"
                    data-date-format="{{# with logged_user.company }}{{this.get_default_date_format_for_date_picker}}{{/with}}"
                    data-date-week-start="{{logged_user.company.first_day_of_week}}" value="{{as_date booking_start}}"
                    name="from_date" required aria-label="From date">
                </div>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="to" class="form-label">
              <i class="fa fa-calendar"></i> To Date:
            </label>
            <div class="row">
              <div class="col-md-5">
                <select class="form-control modal-select" name="to_date_part" required>
                  <option value="1" selected="selected">All day</option>
                  <option value="2">AM</option>
                  <option value="3">PM</option>
                </select>
              </div>
              <div class="col-md-7">
                <div class="input-group">
                  <span class="input-group-addon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                  <input type="text" class="form-control book-leave-to-input modal-input" id="to"
                    data-provide="datepicker" data-date-autoclose="1"
                    data-date-format="{{#with logged_user.company }}{{this.get_default_date_format_for_date_picker}}{{/with}}"
                    data-date-week-start="{{logged_user.company.first_day_of_week}}" value="{{as_date booking_end}}"
                    name="to_date" required aria-label="To date">
                </div>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="leave_reason" class="form-label">
              <i class="fa fa-comment"></i> Comment (Optional):
            </label>
            <textarea class="form-control modal-textarea" id="leave_reason" name="reason" rows="3"
              placeholder="Add any additional details about your absence request..."></textarea>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
            <i class="fa fa-times"></i> Cancel
          </button>
          <button type="submit" class="btn btn-success single-click" id="submitLeaveBtn">
            <i class="fa fa-plus"></i> Create Request
          </button>
          {{# if redirect_back_to }}
          <input type="hidden" name="redirect_back_to" value="{{redirect_back_to}}">
          {{else}}
          <input type="hidden" name="redirect_back_to" value="{{requested_path}}">
          {{/if}}
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('leaveForm');
    var submitBtn = document.getElementById('submitLeaveBtn');
    var fromDate = document.getElementById('from');
    var toDate = document.getElementById('to');

    if (form && submitBtn && fromDate && toDate) {
      // Add event listener to 'from' date input
      fromDate.addEventListener('change', function () {
        // Update 'to' date to match 'from' date
        toDate.value = fromDate.value;
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();

        // Form validation
        if (!form.checkValidity()) {
          e.stopPropagation();
          form.classList.add('was-validated');
          return;
        }

        // Date range validation
        if (new Date(fromDate.value) > new Date(toDate.value)) {
          alert('The "To" date must be after the "From" date.');
          return;
        }

        // Prevent double submission
        if (submitBtn.disabled) {
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';

        // Submit the form
        form.submit();
      });
    }
  });
</script>

<style>
  .professional-modal {
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    border: none;
  }

  .professional-modal .modal-header {
    background: linear-gradient(135deg, var(--secondary-background-color) 0%, var(--hover-bg-color) 100%);
    border-bottom: 1px solid var(--divider-color);
    padding: 25px 30px;
    border-radius: 12px 12px 0 0;
  }

  .modal-title-section {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .modal-icon {
    font-size: 1.8rem;
    color: var(--accent-color);
  }

  .professional-modal .modal-title {
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--text-color);
