    min-height: 80px;
  }

  .modal-textarea:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    outline: none;
  }

  .input-group-addon {
    background: var(--secondary-background-color);
    border: 2px solid var(--divider-color);
    border-right: none;
