<script>
  document.addEventListener('DOMContentLoaded', () => {
    const LEGACY_THEME_MAP = {
      day: 'light',
      night: 'dark',
      ocean: 'light',
      nature: 'light',
      volcano: 'dark',
      neon: 'dark',
      cyberpunk: 'dark'
    }

    function normalizeTheme(theme) {
      if (theme === 'light' || theme === 'dark') {
        return theme
      }
      return LEGACY_THEME_MAP[theme] || 'light'
    }

    function applyTheme(theme) {
      const normalized = normalizeTheme(theme)
      document.body.classList.remove(
        'theme-light', 'theme-dark', 'theme-day', 'theme-night',
        'theme-ocean', 'theme-nature', 'theme-volcano', 'theme-neon', 'theme-cyberpunk'
      )
      document.body.classList.add('theme-' + normalized)

      const lightIcon = document.querySelector('.theme-icon-light')
      const darkIcon = document.querySelector('.theme-icon-dark')
      if (lightIcon && darkIcon) {
        if (normalized === 'dark') {
          lightIcon.classList.add('d-none')
          darkIcon.classList.remove('d-none')
        } else {
          lightIcon.classList.remove('d-none')
          darkIcon.classList.add('d-none')
        }
      }

      localStorage.setItem('theme', normalized)
    }

    const storedTheme = localStorage.getItem('theme') || 'light'
    applyTheme(storedTheme)

    const themeToggle = document.getElementById('theme-toggle')
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        const current = normalizeTheme(localStorage.getItem('theme') || 'light')
        applyTheme(current === 'light' ? 'dark' : 'light')
      })
    }

    // Highlight active nav link
    const path = window.location.pathname
    document.querySelectorAll('.app-navbar .nav-link[href]').forEach(link => {
      const href = link.getAttribute('href')
      if (href && href !== '#' && path.startsWith(href) && href.length > 1) {
        link.classList.add('active')
      }
    })

    function updateNotificationCount() {
      const badge = document.querySelector('.notification-badge')
      if (!badge) return

      fetch('/api/v1/notifications/count')
        .then(response => response.json())
        .then(data => {
          if (data.count > 0) {
            badge.textContent = data.count
            badge.classList.remove('d-none')
          } else {
            badge.classList.add('d-none')
          }
        })
        .catch(error => console.error('Error fetching notification count:', error))
    }

    if (document.querySelector('.notification-badge')) {
      updateNotificationCount()
      setInterval(updateNotificationCount, 300000)
    }

    function updateMessageCount() {
      const messageCountElement = document.querySelector('.message-count')
      if (!messageCountElement) return

      fetch('/messages/count')
        .then(response => response.json())
        .then(data => {
          if (data.count > 0) {
            messageCountElement.textContent = data.count
            messageCountElement.classList.remove('d-none')
          } else {
            messageCountElement.classList.add('d-none')
          }
        })
        .catch(error => console.error('Error fetching message count:', error))
    }

    updateMessageCount()
    setInterval(updateMessageCount, 300000)
  })
</script>
