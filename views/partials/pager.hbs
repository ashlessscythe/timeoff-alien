<ul class="pagination justify-content-center">
  <li class="page-item{{#unless pager.page_prev}} disabled{{/unless}}">
    {{#if pager.page_prev}}
    <a class="page-link" href="?{{#each pager.filter}}{{@key}}={{this}}&{{/each}}page={{pager.page_prev}}">&laquo; Prev</a>
    {{else}}
    <span class="page-link">&laquo; Prev</span>
    {{/if}}
  </li>
  {{#each pager.pages}}
  {{#if_equal this ../pager.page}}
  <li class="page-item active" aria-current="page">
    <span class="page-link">{{this}} of {{../pager.page_qnty}}</span>
  </li>
  {{/if_equal}}
  {{/each}}
  <li class="page-item{{#unless pager.page_next}} disabled{{/unless}}">
    {{#if pager.page_next}}
    <a class="page-link" href="?{{#each pager.filter}}{{@key}}={{this}}&{{/each}}page={{pager.page_next}}">Next &raquo;</a>
    {{else}}
    <span class="page-link">Next &raquo;</span>
    {{/if}}
  </li>
</ul>
