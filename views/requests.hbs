{{> header }}

<h1>{{logged_user.name}} {{logged_user.lastname}} messages</h1>

{{> show_flash_messages }}

{{#if to_be_approved_leaves}}
<div class="alert alert-warning" id="pastPayrollWarning" style="display: none;">
  <strong>CAUTION:</strong> Red highlighted requests are for closed payroll periods (past weeks).
</div>
{{/if}}

<div class="row main-row_header">
  <p class="col-md-12">Leave request to approve</p>
</div>

<!-- Filter Panel - Always visible -->
<div class="row">
  <div class="col-md-12">
    <div class="panel panel-default">
      <div class="panel-heading" role="button" data-toggle="collapse" href="#filterPanel" aria-expanded="false"
        aria-controls="filterPanel">
        <h4 class="panel-title">
          <i class="fa fa-chevron-down collapsed"></i> Filters
          <span class="filter-summary">
            {{#if selected_filters}}
            <span class="badge">Filtered</span>
            <small class="text-muted">
              {{#if selected_filters.departments}}(Departments: {{selected_filters.departments}}){{/if}}
              {{#if selected_filters.types}}(Types: {{selected_filters.types}}){{/if}}
              {{#if selected_filters.month}}(Month: {{selected_filters.month}}){{/if}}
              {{#if selected_filters.year}}(Year: {{selected_filters.year}}){{/if}}
            </small>
            {{else}}
            <span class="badge">All Requests</span>
            {{/if}}
          </span>
        </h4>
      </div>
      <div class="panel-collapse collapse" id="filterPanel">
        <div class="panel-body">
          <div class="row">
            <div class="col-md-6">
              <h5>Departments</h5>
              <div class="filter-section">
                {{#each departments}}
                <label class="filter-checkbox-label">
                  <input type="checkbox" class="filter-checkbox" name="department" value="{{this.id}}" {{#if (includes
                    ../selected_filters.departments this.id)}}checked{{/if}}>
                  {{this.name}}
                </label>
                {{/each}}
              </div>
            </div>
            <div class="col-md-6">
              <h5>Leave Types</h5>
              <div class="filter-section">
                {{#each leave_types}}
                <label class="filter-checkbox-label">
                  <input type="checkbox" class="filter-checkbox" name="type" value="{{this.id}}" {{#if (includes
                    ../selected_filters.types this.id)}}checked{{/if}}>
                  {{this.name}}
                </label>
                {{/each}}
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6">
              <h5>Date Filter</h5>
              <div class="filter-section date-filters">
                <div class="form-group">
                  <label for="monthSelect">Month:</label>
                  <select id="monthSelect" class="form-control" name="month">
                    <option value="">All Months</option>
                    {{#each unique_months}}
                    <option value="{{this}}" {{#if (eq ../selected_filters.month this)}}selected{{/if}}>{{this}}
                    </option>
                    {{/each}}
                  </select>
                </div>
                <div class="form-group">
                  <label for="yearSelect">Year:</label>
                  <select id="yearSelect" class="form-control" name="year">
                    <option value="">All Years</option>
                    {{#each unique_years}}
                    <option value="{{this}}" {{#if (eq ../selected_filters.year this)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                  </select>
                </div>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-12">
              <button class="btn btn-primary apply-filters">Apply Filters</button>
              {{#if selected_filters}}
              <a href="/requests" class="btn btn-default">Clear Filters</a>
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  {{#unless to_be_approved_leaves}}
  <div class="col-md-12 text-muted">
    There are no leave requests to decide on.
  </div>
  {{else}}
  <div class="col-md-12">
    <p class="visible-xs-block"><em class="text-muted">Scroll table horizontally</em></p>
    <div class="table-responsive">
      <table class="table table-hover requests-to-approve-table">
        <thead>
          <tr>
            <th>
              <button class="btn btn-link sort-btn" data-sort="name">
                Employee <i class="fa fa-sort"></i>
              </button>
            </th>
            <th>
              <button class="btn btn-link sort-btn" data-sort="department">
                Department <i class="fa fa-sort"></i>
              </button>
            </th>
            <th>
              <button class="btn btn-link sort-btn" data-sort="date">
                Date of request <i class="fa fa-sort"></i>
              </button>
            </th>
            <th>Leave dates</th>
            <th>
              <button class="btn btn-link sort-btn" data-sort="type">
                Type <i class="fa fa-sort"></i>
              </button>
            </th>
            <th>Days</th>
            <th class="col-xs-2">Comment</th>
            <th colspan="2"></th>
          </tr>
        </thead>
        <tbody>
          {{#each to_be_approved_leaves }}
          <tr vpp="pending_for__{{this.user.email}}" class="{{#if this.isPastPayroll}}past-payroll{{/if}}">
            <td>{{#with this.user}}{{this.full_name}}
              <i class="fa fa-question-circle user-details-summary-trigger" data-user-id="{{this.id}}"></i>{{/with}}
            </td>
            <td class="department-name">{{this.user.department.name}}</td>
            <td class="date_of_request">{{as_date_from_timestamp this.createdAt}}</td>
            <td data-tom-leave-dates="1"><a class="leave-details-summary-trigger" data-leave-id="{{this.id}}"
                href="#">{{> leave_dates leave=this}}</a></td>
            <td class="leave-type">{{#if this.is_pended_revoke_leave}}REVOKE {{/if}}{{this.leave_type.name}}</td>
            <td data-vpp="days_used">{{ this.get_deducted_days_number }}</td>
            <td>{{this.employee_comment}}</td>
            <td>
              <button class="btn btn-warning" data-toggle="modal" data-target="#rejectModal" data-leave-id="{{this.id}}"
                name="reject_modal">
                Reject
              </button>
            </td>
            <td>
              <button class="btn btn-success" data-toggle="modal" data-target="#approveModal"
                data-leave-id="{{this.id}}" name="approve_modal">
                Approve
              </button>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  {{/unless}}
</div>

<div class="main-row_header">&nbsp;</div>

<div class="row main-row_header">
  <p class="col-md-12">All my absences</p>
</div>

{{> user_requests_grouped grouped_leaves=my_leaves_grouped logged_user=logged_user }}
{{> modal_leave_reject }}
{{> modal_leave_approve }}

{{> footer }}

<style>
  /* Past payroll styling */
  tr.past-payroll {
    background-color: #ffebee !important;
  }

  tr.past-payroll:hover {
    background-color: #ffcdd2 !important;
  }

  /* Filter panel styles */
  .panel-heading {
    cursor: pointer;
  }

  .panel-heading .badge {
    background-color: #337ab7;
  }

  .panel-heading .text-muted {
    font-size: 12px;
    margin-left: 5px;
  }

  .filter-summary {
    margin-left: 10px;
  }

  .panel-title .fa {
    transition: transform 0.3s ease;
  }

  .panel-title .fa.collapsed {
    transform: rotate(-90deg);
  }

  .filter-section {
    max-height: 200px;
    overflow-y: auto;
    border: 1px solid #ddd;
    padding: 10px;
    margin-bottom: 15px;
  }

  .filter-checkbox-label {
    display: block;
    padding: 5px 0;
    font-weight: normal;
    cursor: pointer;
  }

  .filter-checkbox-label:hover {
    background-color: #f5f5f5;
  }

  .date-filters .form-group {
    margin-bottom: 10px;
  }

  /* Sort button styles */
  .sort-btn {
    padding: 0;
    color: #333;
    text-decoration: none;
  }

  .sort-btn:hover,
  .sort-btn:focus {
    color: #337ab7;
    text-decoration: none;
  }

  .sort-btn .fa {
    margin-left: 5px;
  }

  .sort-btn.active .fa-sort {
    color: #337ab7;
  }

  .sort-btn.active.asc .fa-sort:before {
    content: "\f0de";
  }

  .sort-btn.active.desc .fa-sort:before {
    content: "\f0dd";
  }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/js/popover-initializer.js"></script>
<script>
  $(document).ready(function () {
    // Show past payroll warning if any past payroll requests exist
    if ($('.past-payroll').length > 0) {
      $('#pastPayrollWarning').show();
    }

    // Enhance approve modal with confirmation for past payroll
    $('#approveModal').on('show.bs.modal', function (event) {
      var button = $(event.relatedTarget);
      var leaveId = button.data('leave-id');
      var row = button.closest('tr');
      var modal = $(this);

      modal.find('input[name="request"]').val(leaveId);
      modal.find('button[type="submit"]').prop('disabled', false);

      // Add warning for past payroll requests
      if (row.hasClass('past-payroll')) {
        var warningHtml = '<div class="alert alert-danger">Warning: This request is for a closed payroll period (past week). Are you sure you want to approve it?</div>';
        modal.find('.modal-body').prepend(warningHtml);
      }
    });

    // Clear warning when modal is hidden
    $('#approveModal').on('hidden.bs.modal', function () {
      $(this).find('.alert-danger').remove();
    });
    // Filter panel functionality
    const filterPanel = $('#filterPanel');
    const panelIcon = $('.panel-heading .fa');

    filterPanel.on('show.bs.collapse', function () {
      panelIcon.removeClass('collapsed');
    });

    filterPanel.on('hide.bs.collapse', function () {
      panelIcon.addClass('collapsed');
    });

    // Apply filters
    $('.apply-filters').on('click', function () {
      const departments = [];
      const types = [];
      const month = $('#monthSelect').val();
      const year = $('#yearSelect').val();

      $('input[name="department"]:checked').each(function () {
        departments.push($(this).val());
      });

      $('input[name="type"]:checked').each(function () {
        types.push($(this).val());
      });

      const params = new URLSearchParams(window.location.search);

      if (departments.length) {
        params.set('departments', departments.join(','));
      } else {
        params.delete('departments');
      }

      if (types.length) {
        params.set('types', types.join(','));
      } else {
        params.delete('types');
      }

      if (month) {
        params.set('month', month);
      } else {
        params.delete('month');
      }

      if (year) {
        params.set('year', year);
      } else {
        params.delete('year');
      }

      window.location.href = window.location.pathname + '?' + params.toString();
    });

    // Sorting functionality
    const sortButtons = $('.sort-btn');
    const tbody = $('.requests-to-approve-table tbody');

    sortButtons.on('click', function () {
      const sortType = $(this).data('sort');
      const isAsc = !$(this).hasClass('asc');

      // Update button states
      sortButtons.removeClass('active asc desc');
      $(this).addClass('active ' + (isAsc ? 'asc' : 'desc'));

      // Get and sort rows
      const rows = tbody.find('tr').get();
      rows.sort(function (a, b) {
        let aVal, bVal;

        switch (sortType) {
          case 'name':
            aVal = $(a).find('td:first').text().trim();
            bVal = $(b).find('td:first').text().trim();
            break;
          case 'department':
            aVal = $(a).find('.department-name').text().trim();
            bVal = $(b).find('.department-name').text().trim();
            break;
          case 'date':
            aVal = new Date($(a).find('.date_of_request').text().trim());
            bVal = new Date($(b).find('.date_of_request').text().trim());
            return isAsc ? aVal - bVal : bVal - aVal;
          case 'type':
            aVal = $(a).find('.leave-type').text().trim();
            bVal = $(b).find('.leave-type').text().trim();
            break;
        }

        if (sortType !== 'date') {
          return isAsc ?
            aVal.localeCompare(bVal) :
            bVal.localeCompare(aVal);
        }
      });

      // Reattach sorted rows
      $.each(rows, function (index, row) {
        tbody.append(row);
      });
    });

    // Handle modal initialization
    $('#rejectModal').on('show.bs.modal', function (event) {
      var button = $(event.relatedTarget);
      var leaveId = button.data('leave-id');
      var modal = $(this);
      modal.find('input[name="request"]').val(leaveId);
      modal.find('textarea[name="comment"]').attr('placeholder', leaveId);
      modal.find('button[type="submit"]').prop('disabled', false);
    });

    $('#approveModal').on('show.bs.modal', function (event) {
      var button = $(event.relatedTarget);
      var leaveId = button.data('leave-id');
      var modal = $(this);
      modal.find('input[name="request"]').val(leaveId);
      modal.find('button[type="submit"]').prop('disabled', false);
    });

    // Handle button clicks in modals
    $('#approveModal button[type="submit"], #rejectModal button[type="submit"]').on('click', function () {
      var $btn = $(this);
      var $form = $btn.closest('form');

      if ($form.find('textarea[required]').length > 0) {
        if (!$form.find('textarea[required]').val().trim()) {
          return true;
        }
      }

      $btn.prop('disabled', true);
      $form.submit();
    });

    // Re-enable buttons when modal is hidden
    $('.modal').on('hidden.bs.modal', function () {
      $(this).find('button[type="submit"]').prop('disabled', false);
    });
  });
</script>