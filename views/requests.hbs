{{> header }}

<!-- Hero Section -->
<div class="requests-hero">
  <div class="container">
    <div class="row">
      <div class="col-md-12 text-center">
        <div class="hero-content">
          <i class="fa fa-clipboard-list hero-icon"></i>
          <h1 class="hero-title">{{logged_user.name}} {{logged_user.lastname}} Messages</h1>
          <p class="hero-subtitle">Manage leave requests and approvals</p>
          <div class="hero-divider"></div>
        </div>
      </div>
    </div>
  </div>
</div>

{{> show_flash_messages }}

{{#if to_be_approved_leaves}}
<div class="container">
  <div class="row">
    <div class="col-md-12">
      <div class="alert alert-warning" id="pastPayrollWarning" style="display: none;">
        <i class="fa fa-exclamation-triangle"></i>
        <strong>CAUTION:</strong> Red highlighted requests are for closed payroll periods (past weeks).
      </div>
    </div>
  </div>
</div>
{{/if}}

<div class="container requests-content">
  <div class="row">
    <div class="col-md-12">
      <div class="section-header">
        <i class="fa fa-tasks section-icon"></i>
        <h2>Leave Requests to Approve</h2>
      </div>
    </div>
  </div>
</div>

<!-- Filter Panel - Always visible -->
<div class="container">
  <div class="row">
    <div class="col-md-12">
      <div class="filter-card">
        <div class="filter-header" role="button" data-toggle="collapse" href="#filterPanel" aria-expanded="false"
          aria-controls="filterPanel">
          <div class="filter-title">
            <i class="fa fa-filter"></i>
            <h3>Filters</h3>
            <span class="filter-summary">
              {{#if selected_filters}}
              <span class="badge filtered">Filtered</span>
              <small class="text-muted">
                {{#if selected_filters.departments}}(Departments: {{selected_filters.departments}}){{/if}}
                {{#if selected_filters.types}}(Types: {{selected_filters.types}}){{/if}}
                {{#if selected_filters.month}}(Month: {{selected_filters.month}}){{/if}}
                {{#if selected_filters.year}}(Year: {{selected_filters.year}}){{/if}}
              </small>
              {{else}}
              <span class="badge all">All Requests</span>
              {{/if}}
            </span>
          </div>
          <i class="fa fa-chevron-down filter-toggle collapsed"></i>
        </div>
        <div class="filter-content collapse" id="filterPanel">
          <div class="filter-body">
            <div class="row">
              <div class="col-md-6">
                <div class="filter-group">
                  <h4><i class="fa fa-building"></i> Departments</h4>
                  <div class="filter-section">
                    {{#each departments}}
                    <label class="filter-checkbox-label">
                      <input type="checkbox" class="filter-checkbox" name="department" value="{{this.id}}" {{#if
                        (includes ../selected_filters.departments this.id)}}checked{{/if}}>
                      <span class="checkmark"></span>
                      {{this.name}}
                    </label>
                    {{/each}}
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="filter-group">
                  <h4><i class="fa fa-calendar"></i> Leave Types</h4>
                  <div class="filter-section">
                    {{#each leave_types}}
                    <label class="filter-checkbox-label">
                      <input type="checkbox" class="filter-checkbox" name="type" value="{{this.id}}" {{#if (includes
                        ../selected_filters.types this.id)}}checked{{/if}}>
                      <span class="checkmark"></span>
                      {{this.name}}
                    </label>
                    {{/each}}
                  </div>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-md-6">
                <div class="filter-group">
                  <h4><i class="fa fa-calendar-alt"></i> Date Filter</h4>
                  <div class="filter-section date-filters">
                    <div class="form-group">
                      <label for="monthSelect">Month:</label>
                      <select id="monthSelect" class="form-control" name="month">
                        <option value="">All Months</option>
                        {{#each unique_months}}
                        <option value="{{this}}" {{#if (eq ../selected_filters.month this)}}selected{{/if}}>{{this}}
                        </option>
                        {{/each}}
                      </select>
                    </div>
                    <div class="form-group">
                      <label for="yearSelect">Year:</label>
                      <select id="yearSelect" class="form-control" name="year">
                        <option value="">All Years</option>
                        {{#each unique_years}}
                        <option value="{{this}}" {{#if (eq ../selected_filters.year this)}}selected{{/if}}>{{this}}
                        </option>
                        {{/each}}
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="filter-actions">
              <button class="btn btn-primary apply-filters">
                <i class="fa fa-check"></i> Apply Filters
              </button>
              {{#if selected_filters}}
              <a href="/requests" class="btn btn-outline-secondary">
                <i class="fa fa-times"></i> Clear Filters
              </a>
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container">
  <div class="row">
    {{#unless to_be_approved_leaves}}
    <div class="col-md-12">
      <div class="no-requests-card">
        <i class="fa fa-inbox"></i>
        <h3>No Leave Requests</h3>
        <p>There are no leave requests to decide on at this time.</p>
      </div>
    </div>
    {{else}}
    <div class="col-md-12">
      <div class="table-container">
        <p class="table-hint visible-xs-block"><i class="fa fa-info-circle"></i> Scroll table horizontally to view all
          columns</p>
        <div class="table-responsive">
          <table class="table table-hover requests-to-approve-table">
            <thead>
              <tr>
                <th>
                  <button class="btn btn-link sort-btn" data-sort="name">
                    Employee <i class="fa fa-sort"></i>
                  </button>
                </th>
                <th>
                  <button class="btn btn-link sort-btn" data-sort="department">
                    Department <i class="fa fa-sort"></i>
                  </button>
                </th>
                <th>
                  <button class="btn btn-link sort-btn" data-sort="date">
                    Date of request <i class="fa fa-sort"></i>
                  </button>
                </th>
                <th>Leave dates</th>
                <th>
                  <button class="btn btn-link sort-btn" data-sort="type">
                    Type <i class="fa fa-sort"></i>
                  </button>
                </th>
                <th>Days</th>
                <th class="col-xs-2">Comment</th>
                <th colspan="2"></th>
              </tr>
            </thead>
            <tbody>
              {{#each to_be_approved_leaves }}
              <tr vpp="pending_for__{{this.user.email}}" class="{{#if this.isPastPayroll}}past-payroll{{/if}}">
                <td>{{#with this.user}}{{this.full_name}}
                  <i class="fa fa-question-circle user-details-summary-trigger" data-user-id="{{this.id}}"></i>{{/with}}
                </td>
                <td class="department-name">{{this.user.department.name}}</td>
                <td class="date_of_request">{{as_date_from_timestamp this.createdAt}}</td>
                <td data-tom-leave-dates="1"><a class="leave-details-summary-trigger" data-leave-id="{{this.id}}"
                    href="#">{{> leave_dates leave=this}}</a></td>
                <td class="leave-type">{{#if this.is_pended_revoke_leave}}REVOKE {{/if}}{{this.leave_type.name}}</td>
                <td data-vpp="days_used">{{ this.get_deducted_days_number }}</td>
                <td>{{this.employee_comment}}</td>
                <td>
                  <button class="btn btn-warning" data-toggle="modal" data-target="#rejectModal"
                    data-leave-id="{{this.id}}" name="reject_modal">
                    Reject
                  </button>
                </td>
                <td>
                  <button class="btn btn-success" data-toggle="modal" data-target="#approveModal"
                    data-leave-id="{{this.id}}" name="approve_modal">
                    Approve
                  </button>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    {{/unless}}
  </div>
</div>

<div class="container">
  <div class="row">
    <div class="col-md-12">
      <div class="section-header">
        <i class="fa fa-history section-icon"></i>
        <h2>All My Absences</h2>
      </div>
    </div>
  </div>
</div>

{{> user_requests_grouped grouped_leaves=my_leaves_grouped logged_user=logged_user }}
{{> modal_leave_reject }}
{{> modal_leave_approve }}

{{> footer }}

