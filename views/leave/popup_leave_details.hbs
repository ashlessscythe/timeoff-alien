{{#if limitedView}}
<div>
  <strong>Dates:</strong> {{leave.startDate}} <i class="fa fa-long-arrow-right"></i> {{leave.endDate}}.
</div>
<div>
  <strong>Employee:</strong> {{leave.employeeFullName}}.
</div>
{{else}}
<div>
  <strong>Dates:</strong> {{leave.startDate}} <i class="fa fa-long-arrow-right"></i> {{leave.endDate}}.
</div>
<div>
  <strong>Type:</strong> {{leave.type}}.
</div>
<div>
  <strong>Employee:</strong> {{leave.employeeFullName}}.
</div>
<div>
  <strong>Deducted days:</strong> {{leave.deductedDays}}.
</div>
<div>
  <strong>Approver:</strong> {{leave.approver}}.
</div>
<div>
  <strong>Requested on:</strong> {{leave.createdTimeStamp}}.
</div>
{{#if leave.commentsString }}
<div>
  <strong>Comments:</strong> {{leave.commentsString}}.
</div>
{{/if}}

{{#if leave.canApprove}}
<div class="leave-actions mt-3">
  <button class="btn btn-warning btn-sm" data-toggle="modal" data-target="#rejectModal" data-leave-id="{{leave.id}}"
    name="reject_modal">
    Reject
  </button>
  <button class="btn btn-success btn-sm" data-toggle="modal" data-target="#approveModal" data-leave-id="{{leave.id}}"
    name="approve_modal">
    Approve
  </button>
</div>
{{/if}}
{{/if}}

<style>
  .leave-actions {
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid #eee;
    text-align: right;
  }

  .leave-actions .btn {
    margin-left: 5px;
  }
</style>