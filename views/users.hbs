{{> header }}

<div class="page-header">
  <div>
    <h1 class="page-header__title">Staff</h1>
    <p class="page-header__subtitle">{{company.name}}'s employees</p>
  </div>
  <div class="page-header__actions">
    <button type="button" class="btn btn-outline-secondary" id="toggle-deactivated-users"
      data-bs-content="Toggle visibility of deactivated users" data-bs-placement="top" data-bs-toggle="tooltip"
      data-bs-trigger="hover">
      <i class="fa fa-eye-slash"></i> Hide deactivated
    </button>
    {{#if logged_user.admin}}
    <div class="btn-group">
      <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
        Add new employee
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="/users/import/" id="import_users_btn">Import employees</a></li>
        <li><a class="dropdown-item" href="/users/add/" id="add_new_department">Add single employee</a></li>
      </ul>
    </div>
    {{/if}}
    <form action="/users/" method="GET" class="d-inline">
      <input type="hidden" name="department" value="{{department_id}}">
      <input type="hidden" name="as-csv" value="1">
      <button class="btn btn-outline-secondary single-click" type="submit"
        data-bs-content="Download current page as .CSV file" data-bs-placement="top" data-bs-toggle="popover"
        data-bs-trigger="focus hover"><i class="fa fa-download"></i> .csv</button>
    </form>
  </div>
</div>

{{> show_flash_messages }}

<div class="row g-3">
  <div class="col-md-3">
    <div class="list-group all-departments staff-sidebar">
  <a href="/users/" class="list-group-item{{#unless department_id }} selected-item{{/unless}}">All departments</a>
  {{#each company.departments}}
  <a class="list-group-item {{#if_equal ../department_id this.id}} selected-item{{/if_equal}}"
    href="/users/?department={{this.id}}">{{this.name}}</a>
  {{/each}}
    </div>
  </div>

<div class="col-md-9">
  <div class="table-responsive">
  <table class="table table-hover staff-table" id="users-table">
    <thead>
      <tr>
        <th class="sortable" data-column="name">
          Name <i class="fa fa-sort sort-icon"></i>
        </th>
        <th class="sortable" data-column="department">
          Department <i class="fa fa-sort sort-icon"></i>
        </th>
        <th class="sortable" data-column="is_admin">
          Is Administrator? <i class="fa fa-sort sort-icon"></i>
        </th>
        <th class="sortable" data-column="is_manager">
          Is Manager <i class="fa fa-sort sort-icon"></i>
        </th>
        <th class="sortable" data-column="allowance">
          Available allowance <i class="fa fa-sort sort-icon"></i>
        </th>
        <th class="sortable" data-column="days_used">
          Days used <i class="fa fa-sort sort-icon"></i>
        </th>
      </tr>
    </thead>
    <tbody>
      {{# each users_info}}
      <tr data-vpp-user-row="{{this.user_id}}" class="{{#unless this.is_active}}deactivated-user{{/unless}}">
        <td class="user-link-cell"><a href="/users/edit/{{this.user_id}}/">{{#unless
            this.is_active}}<s>{{/unless}}{{this.user_full_name}}{{#unless this.is_active}}</s>{{/unless}}</a></td>
        <td class="user_department"><a
            href="/settings/departments/edit/{{ this.department_id }}/">{{this.department_name}}</a></td>
        <td>{{#if this.is_admin}}<span class="role-badge role-badge--yes">Yes</span>{{else}}<span class="cell-empty">—</span>{{/if}}</td>
        <td>{{#if this.is_manager}}<span class="role-badge role-badge--yes">Yes</span>{{else}}<span class="cell-empty">—</span>{{/if}}</td>
        <td class="metric-cell vpp-days-remaining{{#if (lt this.number_of_days_available_in_allowance 0)}} negative{{/if}}">{{
          format_days_and_hours this.number_of_days_available_in_allowance }}</td>
        <td class="metric-cell vpp-days-used">{{format_days_and_hours this.number_of_days_taken_from_allowance}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let showDeactivated = true;
    const toggleButton = document.getElementById('toggle-deactivated-users');
    const deactivatedUsers = document.querySelectorAll('.deactivated-user');

    console.log('Toggle button found:', toggleButton);
    console.log('Deactivated users found:', deactivatedUsers.length);

    if (!toggleButton) {
      console.error('Toggle button not found!');
      return;
    }

    // Initialize tooltip with jQuery if available
    if (typeof $ !== 'undefined') {
      $(toggleButton).tooltip();
    }

    // Toggle functionality
    toggleButton.addEventListener('click', function (e) {
      e.preventDefault();
      console.log('Toggle clicked, current state:', showDeactivated);

      showDeactivated = !showDeactivated;

      if (showDeactivated) {
        deactivatedUsers.forEach(function (user) {
          user.classList.remove('hidden');
        });
        toggleButton.classList.remove('active');
        toggleButton.innerHTML = '<i class="fa fa-eye-slash"></i> Hide deactivated';
        toggleButton.setAttribute('data-content', 'Hide deactivated users');
        console.log('Showing deactivated users');
      } else {
        deactivatedUsers.forEach(function (user) {
          user.classList.add('hidden');
        });
        toggleButton.classList.add('active');
        toggleButton.innerHTML = '<i class="fa fa-eye"></i> Show deactivated';
        toggleButton.setAttribute('data-content', 'Show deactivated users');
        console.log('Hiding deactivated users');
      }

      // Update tooltip content with jQuery if available
      if (typeof $ !== 'undefined') {
        $(toggleButton).tooltip('destroy').tooltip();
      }
    });

    // Table sorting functionality
    const table = document.getElementById('users-table');
    const tbody = table.querySelector('tbody');
    const sortableHeaders = table.querySelectorAll('.sortable');
    let currentSort = { column: null, direction: 'asc' };

    // Sort function
    function sortTable(column, direction) {
      const rows = Array.from(tbody.querySelectorAll('tr'));

      rows.sort((a, b) => {
        let aValue, bValue;

        switch (column) {
          case 'name':
            aValue = a.querySelector('.user-link-cell a').textContent.trim();
            bValue = b.querySelector('.user-link-cell a').textContent.trim();
            break;
          case 'department':
            aValue = a.querySelector('.user_department a').textContent.trim();
            bValue = b.querySelector('.user_department a').textContent.trim();
            break;
          case 'is_admin':
            aValue = a.cells[2].textContent.trim() === 'Yes' ? 1 : 0;
            bValue = b.cells[2].textContent.trim() === 'Yes' ? 1 : 0;
            break;
          case 'is_manager':
            aValue = a.cells[3].textContent.trim() === 'Yes' ? 1 : 0;
            bValue = b.cells[3].textContent.trim() === 'Yes' ? 1 : 0;
            break;
          case 'allowance':
            aValue = parseFloat(a.querySelector('.vpp-days-remaining').textContent.trim()) || 0;
            bValue = parseFloat(b.querySelector('.vpp-days-remaining').textContent.trim()) || 0;
            break;
          case 'days_used':
            aValue = parseFloat(a.querySelector('.vpp-days-used').textContent.trim()) || 0;
            bValue = parseFloat(b.querySelector('.vpp-days-used').textContent.trim()) || 0;
            break;
          default:
            return 0;
        }

        // Handle string comparison
        if (typeof aValue === 'string' && typeof bValue === 'string') {
          return direction === 'asc' ? aValue.localeCompare(bValue) : bValue.localeCompare(aValue);
        }

        // Handle numeric comparison
        return direction === 'asc' ? aValue - bValue : bValue - aValue;
      });

      // Clear tbody and re-append sorted rows
      tbody.innerHTML = '';
      rows.forEach(row => tbody.appendChild(row));
    }

    // Add click listeners to sortable headers
    sortableHeaders.forEach(header => {
      header.addEventListener('click', function () {
        const column = this.getAttribute('data-column');

        // Determine sort direction
        let direction = 'asc';
        if (currentSort.column === column && currentSort.direction === 'asc') {
          direction = 'desc';
        }

        // Update current sort
        currentSort = { column, direction };

        // Remove sort classes from all headers
        sortableHeaders.forEach(h => {
          h.classList.remove('sorted-asc', 'sorted-desc');
        });

        // Add sort class to current header
        this.classList.add(direction === 'asc' ? 'sorted-asc' : 'sorted-desc');

        // Sort the table
        sortTable(column, direction);
      });
    });
  });
</script>

{{> footer }}