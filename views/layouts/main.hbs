<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Open source Staff Time off management system">
  <link rel="icon" href="/favicon.ico">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <title>{{title}}</title>

  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/font-awesome.min.css">
  <link rel="stylesheet" href="/css/style.css" />
  {{#each custom_css}}
  <link rel="stylesheet" href="{{this}}" />
  {{/each}}
</head>

<body class="app-shell">
  <div class="app-main">
    {{{body}}}
  </div>

  <script src="/js/jquery.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/js/bootstrap-jquery-bridge.js"></script>
  <script src="/js/leave-details-popover.js"></script>
  {{~#each custom_java_script~}}
  <script src="{{this}}"></script>
  {{~/each~}}

  {{> cookie_banner }}

  {{#if logged_user.company.first_day_of_week}}
  <script>
    window.companyFirstDayOfWeek = {{ logged_user.company.first_day_of_week }};
  </script>
  {{/if}}

</body>

</html>
