{{> header }}

<h1>Preview PTO Adjustments</h1>

<p class="lead">Review and confirm adjustments before applying</p>

{{> show_flash_messages }}

<div class="row">
  <div class="col-md-6">
    <ol class="breadcrumb">
      <li><a class="dropdown-item" href="/settings/general/">Settings</a></li>
      <li><a class="dropdown-item" href="/settings/pto-adjustment/">Bulk PTO Adjustment</a></li>
      <li class="active">Preview</li>
    </ol>
  </div>
</div>

{{#if errors.length}}
<div class="row">
  <div class="col-md-12">
    <div class="card border-danger">
      <div class="card-header">
        <i class="fa fa-exclamation-triangle"></i> Errors ({{errors.length}})
      </div>
      <div class="card-body">
        <p>The following rows could not be processed:</p>
        <table class="table table-condensed">
          <thead>
            <tr>
              <th>Row</th>
              <th>Name from CSV</th>
              <th>Error</th>
              <th>Suggestions</th>
            </tr>
          </thead>
          <tbody>
            {{#each errors}}
            <tr>
              <td>{{this.row}}</td>
              <td><strong>{{this.name}}</strong></td>
              <td class="text-danger">{{this.error}}</td>
              <td>
                {{#if this.suggestions}}
                <small class="text-muted">{{this.suggestions}}</small>
                {{else}}
                <small class="text-muted">-</small>
                {{/if}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{{/if}}

{{#if preview.length}}
<div class="row">
  <div class="col-md-12">
    <div class="card">
      <div class="card-header">
        <i class="fa fa-list"></i> Preview ({{preview.length}} adjustments)
      </div>
      <div class="card-body">
        <form method="POST" action="/settings/pto-adjustment/apply/" id="pto_apply_form">
          <div class="form-group" style="margin-bottom: 15px;">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="select_all_btn">
              <i class="fa fa-check-square-o"></i> Select All
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="unselect_all_btn" style="display: none;">
              <i class="fa fa-square-o"></i> Unselect All
            </button>
            <span class="text-muted" style="margin-left: 10px;">
              <span id="selected_count">{{preview.length}}</span> of {{preview.length}} selected
            </span>
          </div>
          <div class="table-responsive">
            <table class="table table-striped table-hover">
              <thead>
                <tr>
                  <th>
                    <input type="checkbox" id="select_all_checkbox" checked>
                  </th>
                  <th>Row</th>
                  <th>CSV Name</th>
                  <th>Matched Employee</th>
                  <th>Match Confidence</th>
                  <th>Year</th>
                  <th>Adjustment</th>
                  <th>Personal Adjustment</th>
                </tr>
              </thead>
              <tbody>
                {{#each preview}}
                <tr class="{{#if this.needsConfirmation}}warning{{/if}}">
                  <td>
                    <input type="checkbox" name="confirmed_rows[]" value="{{this.row}}" checked>
                  </td>
                  <td>{{this.row}}</td>
                  <td>
                    <strong>{{this.csvName}} {{this.csvLastname}}</strong>
                    {{#if this.needsConfirmation}}
                    <br><small class="text-warning"><i class="fa fa-exclamation-triangle"></i> Low confidence
                      match</small>
                    {{/if}}
                  </td>
                  <td>
                    <strong>{{this.matchedName}}</strong>
                    <br><small class="text-muted">ID: {{this.matchedUserId}}</small>
                  </td>
                  <td>
                    {{#if (gte this.matchScore 0.9)}}
                    <span class="badge bg-success">{{percent this.matchScore}}%</span>
                    {{else if (gte this.matchScore 0.7)}}
                    <span class="badge bg-warning text-dark">{{percent this.matchScore}}%</span>
                    {{else}}
                    <span class="badge bg-danger">{{percent this.matchScore}}%</span>
                    {{/if}}
                  </td>
                  <td>{{this.year}}</td>
                  <td>{{this.adjustment}}</td>
                  <td>{{this.personalAdjustment}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>

          <div class="form-group" style="margin-top: 20px;">
            <button type="button" class="btn btn-outline-secondary" onclick="window.history.back()">
              <i class="fa fa-arrow-left"></i> Go Back
            </button>
            <button type="submit" class="btn btn-success float-end single-click" id="apply_pto_btn">
              <i class="fa fa-check"></i> Apply Selected Adjustments
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{/if}}

{{#unless preview.length}}
{{#unless errors.length}}
<div class="row">
  <div class="col-md-12">
    <div class="alert alert-info">
      <i class="fa fa-info-circle"></i> No data to preview. Please upload a CSV file.
    </div>
  </div>
</div>
{{/unless}}
{{/unless}}

{{> footer }}

<script>
  (function () {
    function updateSelectedCount() {
      const checkboxes = document.querySelectorAll('input[name="confirmed_rows[]"]')
      const total = checkboxes.length
      const checked = document.querySelectorAll('input[name="confirmed_rows[]"]:checked').length
      const selectedCountEl = document.getElementById('selected_count')
      const selectAllCheckbox = document.getElementById('select_all_checkbox')
      const selectAllBtn = document.getElementById('select_all_btn')
      const unselectAllBtn = document.getElementById('unselect_all_btn')

      if (selectedCountEl) {
        selectedCountEl.textContent = checked
      }

      if (selectAllCheckbox) {
        selectAllCheckbox.checked = total === checked
      }

      // Toggle button visibility
      if (selectAllBtn && unselectAllBtn) {
        if (checked === total) {
          selectAllBtn.style.display = 'none'
          unselectAllBtn.style.display = 'inline-block'
        } else {
          selectAllBtn.style.display = 'inline-block'
          unselectAllBtn.style.display = 'none'
        }
      }
    }

    function init() {
      const selectAllBtn = document.getElementById('select_all_btn')
      const unselectAllBtn = document.getElementById('unselect_all_btn')
      const selectAllCheckbox = document.getElementById('select_all_checkbox')
      const form = document.getElementById('pto_apply_form')
      const checkboxes = document.querySelectorAll('input[name="confirmed_rows[]"]')

      if (!selectAllBtn || !unselectAllBtn) return

      // Select all button
      selectAllBtn.addEventListener('click', function () {
        checkboxes.forEach(function (checkbox) {
          checkbox.checked = true
        })
        updateSelectedCount()
      })

      // Unselect all button
      unselectAllBtn.addEventListener('click', function () {
        checkboxes.forEach(function (checkbox) {
          checkbox.checked = false
        })
        updateSelectedCount()
      })

      // Select all checkbox functionality
      if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', function () {
          const isChecked = this.checked
          checkboxes.forEach(function (checkbox) {
            checkbox.checked = isChecked
          })
          updateSelectedCount()
        })
      }

      // Update when individual checkboxes change
      checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
          updateSelectedCount()
        })
      })

      // Confirm before applying
      if (form) {
        form.addEventListener('submit', function (e) {
          const checked = document.querySelectorAll('input[name="confirmed_rows[]"]:checked').length
          if (checked === 0) {
            e.preventDefault()
            alert('Please select at least one adjustment to apply.')
            return false
          }

          if (!confirm('Are you sure you want to apply ' + checked + ' adjustment(s)? This will update or create allowance adjustments for the selected employees.')) {
            e.preventDefault()
            return false
          }
        })
      }

      // Initialize on page load
      updateSelectedCount()
    }

    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init)
    } else {
      init()
    }
  })()
</script>