{{> header }}

{{#if show_public_banner}}
<div class="alert" role="alert" style="background-color: {{public_message_bg}}; color: {{public_message_font}}">
  {{{public_banner_message}}}
</div>
{{/if}}

<h1>Login</h1>

{{> show_flash_messages }}

<div class="alert alert-warning">
  <small><i class="fa fa-shield"></i> Security Notice: Unauthorized access attempts are prohibited and monitored. All
    activities are logged.</small>
</div>

{{#if login.default}}
<form class="form-horizontal" action="/login" method="post">

  <div class="row">&nbsp;</div>
  <div class="form-group">
    <label for="email_inp" class="col-md-2 control-label col-md-offset-2">Employee email:</label>
    <div class="col-md-5">
      <input class="form-control" id="email_inp" type="text" name="username" required>
    </div>
  </div>

  <div class="form-group">
    <label for="pass_inp" class="col-md-2 control-label col-md-offset-2">Password</label>
    <div class="col-md-5">
      <input class="form-control" id="pass_inp" type="password" name="password" required>
    </div>
  </div>

  {{#if turnstile_site_key}}
  <div class="form-group">
    <div class="col-md-offset-4 col-md-5">
      <div class="cf-turnstile" data-sitekey="{{turnstile_site_key}}"></div>
    </div>
  </div>
  {{/if}}

  <div class="form-group">
    <div class="col-md-offset-4 col-md-1">
      <button type="submit" class="btn btn-success single-click" id="submit_login">Login</button>
    </div>
    <div class="col-md-4">
      <p class="pull-right"><a href="/forgot-password/">Forgot password?</a>{{#if allow_create_new_accounts }} | <a
          href="/register/">Register new company</a>{{/if}}</p>
    </div>
  </div>

</form>
{{/if}}

{{#if login.google}}
<form action="/auth/google" method="GET">
  <button type="submit" class="btn btn-default btn-login-google">
    <span class="provider-logo google"></span> Login with Google
  </button>
</form>
{{/if}}

<div class="row">&nbsp;</div>


{{> footer }}