{{> header }}

<!-- Hero Section -->
<div class="terms-hero">
  <div class="container">
    <div class="row">
      <div class="col-md-12 text-center">
        <div class="hero-content">
          <i class="fa fa-shield-alt hero-icon"></i>
          <h1 class="hero-title">Terms of Service</h1>
          <p class="hero-subtitle">Legal framework and security guidelines for our platform</p>
          <div class="hero-divider"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Main Content -->
<div class="container terms-content">
  <div class="row">
    <div class="col-md-10 col-md-offset-1">

      <!-- Prohibited Activities Section -->
      <div class="terms-section">
        <div class="section-header">
          <i class="fa fa-ban section-icon"></i>
          <h2>Prohibited Activities</h2>
        </div>
        <div class="section-content">
          <div class="alert alert-warning">
            <i class="fa fa-exclamation-triangle"></i>
            <strong>Important:</strong> Unauthorized access and malicious activities are strictly prohibited.
          </div>
          <p>Unauthorized access, including but not limited to hacking, password mining, or other means of accessing
            unauthorized information, is strictly prohibited and may result in civil and/or criminal liability. We
            reserve
            the right to take legal action against individuals or entities involved in such activities.</p>
        </div>
      </div>

      <!-- Security Notice Section -->
      <div class="terms-section">
        <div class="section-header">
          <i class="fa fa-gavel section-icon"></i>
          <h2>Security Notice</h2>
        </div>
        <div class="section-content">
          <div class="alert alert-danger">
            <i class="fa fa-shield-alt"></i>
            <strong>Legal Warning:</strong> Unauthorized access violations may lead to prosecution.
          </div>
          <p>Unauthorized access or attempts to disrupt this service are violations of the law and may lead to
            prosecution
            under applicable laws, including the Computer Fraud and Abuse Act (CFAA). All activities are logged and
            monitored.</p>
        </div>
      </div>

      <!-- Privacy and Security Section -->
      <div class="terms-section">
        <div class="section-header">
          <i class="fa fa-lock section-icon"></i>
          <h2>Privacy and Security</h2>
        </div>
        <div class="section-content">
          <div class="security-features">
            <div class="feature-item">
              <i class="fa fa-check-circle"></i>
              <span>Advanced security monitoring</span>
            </div>
            <div class="feature-item">
              <i class="fa fa-check-circle"></i>
              <span>Comprehensive activity logging</span>
            </div>
            <div class="feature-item">
              <i class="fa fa-check-circle"></i>
              <span>Authorities notification system</span>
            </div>
          </div>
          <p>We take the security of our systems seriously. Attempts to breach security measures may be reported to the
            appropriate authorities.</p>
        </div>
      </div>

      <!-- Security Vulnerability Reporting Section -->
      <div class="terms-section">
        <div class="section-header">
          <i class="fa fa-bug section-icon"></i>
          <h2>Security Vulnerability Reporting</h2>
        </div>
        <div class="section-content">
          <div class="reporting-options">
            <div class="reporting-card">
              <div class="card-header">
                <i class="fa fa-github"></i>
                <h3>GitHub Issues</h3>
              </div>
              <p>Report vulnerabilities through our official GitHub Issues page for public tracking and community
                visibility.</p>
              <a href="https://github.com/ashlessscythe/timeoff-alien/issues" class="btn btn-primary" target="_blank">
                <i class="fa fa-external-link-alt"></i> Report on GitHub
              </a>
            </div>

            <div class="reporting-card">
              <div class="card-header">
                <i class="fa fa-envelope"></i>
                <h3>Direct Contact</h3>
              </div>
              <p>Contact us directly through our GitHub repository for private or sensitive security concerns.</p>
              <a href="https://github.com/ashlessscythe/timeoff-alien" class="btn btn-outline-primary" target="_blank">
                <i class="fa fa-external-link-alt"></i> Contact Repository
              </a>
            </div>
          </div>

          <div class="appreciation-note">
            <i class="fa fa-heart"></i>
            <p>We appreciate the work of ethical security researchers in helping maintain the security and privacy of
              our
              platform.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  /* Hero Section Styling */
  .terms-hero {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 80px 0;
    margin-bottom: 40px;
    position: relative;
    overflow: hidden;
  }

  .terms-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.1"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.1"/><circle cx="50" cy="10" r="0.5" fill="white" opacity="0.1"/><circle cx="10" cy="60" r="0.5" fill="white" opacity="0.1"/><circle cx="90" cy="40" r="0.5" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
    opacity: 0.3;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-icon {
    font-size: 4rem;
    margin-bottom: 20px;
    opacity: 0.9;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.05);
    }

    100% {
      transform: scale(1);
    }
  }

  .hero-title {
    font-size: 5.5rem;
    font-weight: 700;
    margin-bottom: 15px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .hero-subtitle {
    font-size: 2rem;
    opacity: 0.9;
    margin-bottom: 30px;
    font-weight: 300;
  }

  .hero-divider {
    width: 100px;
    height: 4px;
    background: white;
    margin: 0 auto;
    border-radius: 2px;
  }

  /* Main Content Styling */
  .terms-content {
    padding-bottom: 60px;
  }

  .terms-section {
    margin-bottom: 50px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .terms-section:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  .section-header {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    padding: 25px 30px;
    border-bottom: 1px solid #dee2e6;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .section-icon {
    font-size: 1.8rem;
    color: #667eea;
    width: 40px;
    text-align: center;
  }

  .section-header h2 {
    margin: 0;
    font-size: 2.8rem;
    font-weight: 600;
    color: #2c3e50;
  }

  .section-content {
    padding: 30px;
  }

  /* Alert Styling */
  .alert {
    border-radius: 8px;
    border: none;
    padding: 20px;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.4rem;
  }

  .alert-warning {
    background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
    color: #856404;
    border-left: 4px solid #ffc107;
  }

  .alert-danger {
    background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
    color: #721c24;
    border-left: 4px solid #dc3545;
  }

  .alert i {
    font-size: 1.2rem;
  }

  /* Security Features */
  .security-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 25px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px;
    background: #f8f9fa;
    border-radius: 8px;
    border-left: 4px solid #28a745;
    transition: background 0.3s ease;
  }

  .feature-item:hover {
    background: #e9ecef;
  }

  .feature-item i {
    color: #28a745;
    font-size: 1.1rem;
  }

  .feature-item span {
    font-weight: 500;
    color: #495057;
    font-size: 1.3rem;
  }

  /* Reporting Options */
  .reporting-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 25px;
    margin-bottom: 30px;
  }

  .reporting-card {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 25px;
    border: 1px solid #e9ecef;
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .reporting-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    border-color: #667eea;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 15px;
  }

  .card-header i {
    font-size: 1.5rem;
    color: #667eea;
  }

  .card-header h3 {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 600;
    color: #2c3e50;
  }

  .reporting-card p {
    color: #6c757d;
    margin-bottom: 20px;
    flex-grow: 1;
    font-size: 1.3rem;
  }

  .btn {
    border-radius: 6px;
    padding: 12px 20px;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
    color: white;
    text-decoration: none;
  }

  .btn-outline-primary {
    background: transparent;
    color: #667eea;
    border: 2px solid #667eea;
  }

  .btn-outline-primary:hover {
    background: #667eea;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.3);
    text-decoration: none;
  }

  /* Appreciation Note */
  .appreciation-note {
    background: linear-gradient(135deg, #e8f5e8 0%, #f0f8f0 100%);
    border-radius: 12px;
    padding: 25px;
    border-left: 4px solid #28a745;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .appreciation-note i {
    font-size: 1.5rem;
    color: #e74c3c;
    animation: heartbeat 1.5s ease-in-out infinite;
  }

  @keyframes heartbeat {
    0% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.1);
    }

    100% {
      transform: scale(1);
    }
  }

  .appreciation-note p {
    margin: 0;
    color: #2c3e50;
    font-style: italic;
    font-weight: 500;
    font-size: 1.4rem;
  }

  /* Typography Improvements */
  .terms-content p {
    line-height: 1.7;
    color: #495057;
    font-size: 1.5rem;
  }

  .terms-content h2 {
    line-height: 1.3;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 3.5rem;
    }

    .hero-subtitle {
      font-size: 1.5rem;
    }

    .section-header {
      padding: 20px;
    }

    .section-header h2 {
      font-size: 2.2rem;
    }

    .section-content {
      padding: 20px;
    }

    .terms-content p {
      font-size: 1.3rem;
    }

    .alert {
      font-size: 1.2rem;
    }

    .reporting-options {
      grid-template-columns: 1fr;
    }

    .security-features {
      grid-template-columns: 1fr;
    }
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }
</style>

{{> footer }}