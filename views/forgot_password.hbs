{{> header }}

<div class="auth-page">
  <div class="page-header">
    <div>
      <h1 class="page-header__title">Forgot password</h1>
      <p class="page-header__subtitle">We'll send reset instructions to your email</p>
    </div>
  </div>

  {{> show_flash_messages }}

  <div class="auth-card">
    <form class="form-modern" action="/forgot-password/" method="post">
      <div class="mb-3">
        <label for="email_inp" class="form-label">Employee email</label>
        <input class="form-control" id="email_inp" type="text" name="email" required autocomplete="email">
      </div>

      {{#if turnstile_site_key}}
      <div class="mb-3">
        <div class="cf-turnstile" data-sitekey="{{turnstile_site_key}}"></div>
      </div>
      {{/if}}

      <button type="submit" class="btn btn-primary single-click" id="submit_login">Send instructions</button>
    </form>
  </div>
</div>

{{> footer }}
