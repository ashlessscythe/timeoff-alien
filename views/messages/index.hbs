{{> header }}

<div class="row">
  <div class="col-md-12">
    <h1>User Messages</h1>

    {{> show_flash_messages }}

    <table class="table table-hover">
      <thead>
        <tr>
          <th>Date</th>
          <th>Name</th>
          <th>Email</th>
          <th>Message</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each messages}}
        <tr>
          <td>{{as_date this.created_at}}</td>
          <td>{{this.name}}</td>
          <td>{{this.email}}</td>
          <td>{{this.message}}</td>
          <td>
            <span class="label {{#if (eq this.status 'new')}}label-primary{{else}}label-default{{/if}}">
              {{this.status}}
            </span>
          </td>
          <td>
            <form method="POST" action="/messages/{{this.id}}/status" class="form-inline" style="display:inline;">
              <select name="status" class="form-control input-sm" onchange="this.form.submit()">
                <option value="new" {{#if (eq this.status 'new' )}}selected{{/if}}>New</option>
                <option value="in-progress" {{#if (eq this.status 'in-progress' )}}selected{{/if}}>In Progress</option>
                <option value="resolved" {{#if (eq this.status 'resolved' )}}selected{{/if}}>Resolved</option>
              </select>
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    {{#unless messages}}
    <div class="well">No messages yet.</div>
    {{/unless}}
  </div>
</div>

{{> book_leave_modal }}