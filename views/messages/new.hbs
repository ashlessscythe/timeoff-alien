{{> header }}

<div class="row">
  <div class="col-md-6 col-md-offset-3">
    <h1>Contact Administrators</h1>

    <div class="alert alert-warning" style="color: #d9534f;">
      <strong>Wrong Form:</strong> For time off requests, go to the <a href="/"
        style="color: inherit; text-decoration: underline;">dashboard</a> and click "New absence".
    </div>

    <div class="alert alert-info">
      <p>Send a message to administrators for:</p>
      <ul>
        <li>Technical issues</li>
        <li>Feature requests</li>
        <li>Help with using the system</li>
        <li>Feedback</li>
      </ul>
      <p>We will respond to your registered email address.</p>
    </div>

    {{> show_flash_messages }}

    <form method="POST" action="/messages">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" class="form-control" id="name" name="name"
          value="{{logged_user.name}} {{logged_user.lastname}}" readonly>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" class="form-control" id="email" name="email" value="{{logged_user.email}}" readonly>
      </div>

      <div class="form-group">
        <label for="subject">Subject</label>
        <input type="text" class="form-control" id="subject" name="subject" required placeholder="What is this about?">
      </div>

      <div class="form-group">
        <label for="message">Message</label>
        <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
      </div>

      <button type="submit" class="btn btn-success">Send Message</button>
      <a href="/" class="btn btn-link">Cancel</a>
    </form>
  </div>
</div>

{{> book_leave_modal }}