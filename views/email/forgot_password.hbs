🔐 Reset Your Password - {{#if header_title}}{{header_title}}{{else}}TimeOff.Management{{/if}}
=====
{{# with user ~}}
<h2>Hello {{this.name}},</h2>

<div class="info-box">
  <p><strong>Password Reset Request</strong></p>
  <p>We received a request to reset the password for your account at {{#if header_title}}{{> email/link
    href=(get_application_domain) text=header_title }}{{else}}{{> email/link href=(get_application_domain)
    text='TimeOff.Management' }}{{/if}}.</p>
</div>

{{# if ../company.ldap_auth_enabled }}
<div class="info-box info-box-warning">
  <h3 style="margin-top: 0; color: #d97706;">LDAP Authentication Detected</h3>
  <p>Your company uses LDAP authentication, so we cannot reset your password directly.</p>
  <p><strong>Next Steps:</strong> Please contact your system administrator to reset your password in Active Directory.
  </p>
</div>

{{ else }}
<div class="info-box info-box-success">
  <h3 style="margin-top: 0; color: #059669;">Ready to Reset</h3>
  <p>Click the button below to reset your password:</p>
  <div style="text-align: center; margin: 20px 0;">
    <a href="{{concatenate (get_application_domain) '/reset-password/?t=' ../token}}" class="btn"
      style="display: inline-block; padding: 12px 24px; background-color: #3b82f6; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 500; font-size: 16px;">Reset
      My Password</a>
  </div>
</div>

<div class="info-box">
  <h3 style="margin-top: 0; color: #1f2937;">Alternative Method</h3>
  <p>If the button doesn't work, copy and paste this link into your browser:</p>
  <div
    style="background-color: #f3f4f6; padding: 12px; border-radius: 6px; font-family: monospace; font-size: 14px; word-break: break-all; border: 1px solid #d1d5db;">
    {{ concatenate (get_application_domain) '/reset-password/?t=' ../token }}
  </div>
</div>

<div class="info-box info-box-success">
  <h3 style="margin-top: 0; color: #059669;">🔒 Password Security Requirements</h3>
  <p style="font-weight: 500; margin-bottom: 12px;">Your new password must meet these requirements:</p>
  <ul style="padding-left: 20px; margin: 0;">
    <li style="margin-bottom: 8px;">✅ Be between 12 and 128 characters long</li>
    <li style="margin-bottom: 8px;">✅ Not contain any spaces</li>
    <li style="margin-bottom: 8px;">✅ Not be a commonly used password</li>
  </ul>
  <p style="font-style: italic; margin-top: 12px; color: #6b7280; font-size: 14px;">
    💡 <strong>Pro Tip:</strong> Use a password manager to generate and store a strong, unique password. All characters
    (except spaces) are allowed, including letters, numbers, and special characters.
  </p>
</div>
{{/if}}

{{~/ with}}

<div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
  <p style="color: #6b7280; font-size: 14px; margin: 0;">If you didn't request this password reset, please ignore this
    email or contact support if you have concerns.</p>
</div>

<p style="margin-top: 20px;">Best regards,<br>
  <strong>The {{#if header_title}}{{header_title}}{{else}}TimeOff.Management{{/if}} Team</strong>
</p>